#!/usr/bin/env python3
"""
NyxForge Bounty Holder Portfolio mockup generator.
Generates docs/storyboards/out/bounty-holder-mockup.html

5 frames:
  1. Portfolio     -- all .bounty files held, status/value grid
  2. Bounty Detail -- single bounty: terms, collateral, judge, DLEQ
  3. Transfer      -- change bearer key / send file to new holder
  4. File Claim    -- CTA bridge to claim wizard (pre-filled)
  5. History       -- settled, expired, transferred bounties
"""
import os

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
OUTDIR     = os.path.join(os.environ.get("NYXFORGE_ROOT", os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))), "docs/storyboards/out")
OUTFILE    = os.path.join(OUTDIR, "bounty-holder-mockup.html")

BG=("#0d0f1a"); SURF=("#131524"); SURF_HI=("#1a1d2e")
ACCENT=("#5e6ad2"); ACC_GLO=("#2d3068"); TXT_PRI=("#e8eaf0")
TXT_SEC=("#b8c0d8"); TXT_MUT=("#8b95b0"); SUCCESS=("#4ade80")
DANGER=("#f87171"); WARN=("#fbbf24"); BORDER=("#2a2d3e"); INACT=("#3a3d5c")
SUCCESS_RGBA="rgba(74,222,128,0.10)"; WARN_RGBA="rgba(251,191,36,0.10)"
ACCENT_RGBA="rgba(94,106,210,0.12)"; DANGER_RGBA="rgba(248,113,113,0.10)"
FW=960

def sl(t): return f'<div style="font-size:11px;font-weight:700;letter-spacing:1.2px;color:{ACCENT};margin-bottom:8px;">{t}</div>'
def div(mb=12): return f'<div style="height:1px;background:{BORDER};margin:0 0 {mb}px;"></div>'
def pill(t,c,bg): return f'<span style="font-size:10px;font-weight:700;letter-spacing:0.8px;padding:3px 9px;border-radius:4px;color:{c};background:{bg};">{t}</span>'
def btn(l,color=SUCCESS,text_color=BG,small=False,full=False):
    p="7px 16px" if small else "13px 28px";fs="12px" if small else "14px"
    w="width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return f'<div style="{w}padding:{p};background:{color};border-radius:7px;font-size:{fs};font-weight:700;color:{text_color};cursor:pointer;">{l}</div>'
def btn_o(l,small=False,color=None,full=False):
    p="6px 14px" if small else "12px 27px";fs="12px" if small else "14px"
    col=color or TXT_SEC;brd=color or BORDER
    w="width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return f'<div style="{w}padding:{p};background:transparent;border:1px solid {brd};border-radius:7px;font-size:{fs};color:{col};cursor:pointer;">{l}</div>'
def inp(label,val,mono=False,note=None):
    f="monospace" if mono else "inherit"
    n=f'<div style="font-size:11px;color:{TXT_MUT};margin-top:4px;">{note}</div>' if note else ""
    return (f'<div style="margin-bottom:12px;"><div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">{label}</div>'
            f'<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:6px;padding:9px 13px;font-size:13px;color:{TXT_MUT};font-family:{f};">{val}</div>{n}</div>')
def hdr():
    return f"""<div style="background:{SURF};border-bottom:1px solid {BORDER};padding:13px 24px;
              display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:14px;">
      <div style="width:28px;height:28px;border-radius:6px;background:{ACC_GLO};display:flex;align-items:center;
                  justify-content:center;font-size:11px;font-weight:700;color:{ACCENT};">NYX</div>
      <div><div style="font-size:15px;font-weight:700;color:{TXT_PRI};">Holder Portfolio</div>
           <div style="font-size:11px;color:{TXT_MUT};">.bounty files you hold</div></div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;">
      <div style="font-size:12px;font-family:monospace;color:{TXT_MUT};">7Ab2...88Fc</div>
    </div></div>"""

def frame(title,sub,body):
    return f"""<div style="background:{BG};min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  {hdr()}
  <div style="max-width:{FW}px;margin:0 auto;padding:28px 32px;">
    <div style="margin-bottom:22px;">
      <div style="font-size:11px;font-weight:700;letter-spacing:1.2px;color:{ACCENT};margin-bottom:4px;text-transform:uppercase;">{title}</div>
      <div style="font-size:22px;font-weight:700;color:{TXT_PRI};">{sub}</div>
    </div>
    {body}
  </div></div>"""

def bounty_card(bid,series,subject,collateral,maturity,status,sc,sbg,units=1):
    return f"""<div style="background:{SURF};border:1px solid {BORDER};border-radius:10px;padding:18px 20px;cursor:pointer;">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
    <div>
      <div style="font-family:monospace;font-size:12px;color:{ACCENT};margin-bottom:3px;">{bid}</div>
      <div style="font-size:14px;font-weight:700;color:{TXT_PRI};">{subject}</div>
      <div style="font-size:11px;color:{TXT_MUT};margin-top:2px;">{series}</div>
    </div>
    {pill(status,sc,sbg)}
  </div>
  {div(8)}
  <div style="display:flex;justify-content:space-between;">
    <div><div style="font-size:11px;color:{TXT_MUT};">Collateral</div>
         <div style="font-size:15px;font-weight:700;color:{WARN};">{collateral}</div></div>
    <div><div style="font-size:11px;color:{TXT_MUT};">Maturity</div>
         <div style="font-size:13px;color:{TXT_PRI};">{maturity}</div></div>
    <div><div style="font-size:11px;color:{TXT_MUT};">Units held</div>
         <div style="font-size:13px;color:{TXT_PRI};">{units}</div></div>
  </div></div>"""

def term_row(seq,goal_type,criterion,operator="",threshold="",data_id=""):
    type_c = {"quantitative":ACCENT,"qualitative":SUCCESS,"hybrid":WARN}.get(goal_type,TXT_MUT)
    op_map = {"lt":"<","lte":"<=","gt":">","gte":">=","eq":"="}
    crit_str = f"{data_id} {op_map.get(operator,'')} {threshold}" if operator else criterion
    return f"""<div style="padding:12px 14px;background:{SURF_HI};border:1px solid {BORDER};border-radius:7px;margin-bottom:8px;">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
    <span style="font-size:10px;font-weight:700;color:{type_c};background:rgba(94,106,210,0.1);padding:2px 7px;border-radius:3px;">{goal_type.upper()}</span>
    <span style="font-size:12px;color:{TXT_MUT};">Term {seq}</span>
  </div>
  <div style="font-size:13px;color:{TXT_PRI};">{criterion}</div>
  {"" if not data_id else f'<div style="font-size:11px;font-family:monospace;color:{TXT_MUT};margin-top:3px;">{crit_str}</div>'}
</div>"""

def f1():
    stats = f"""<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;">
  {"".join(f'<div style="background:{SURF};border:1px solid {BORDER};border-radius:8px;padding:14px 16px;">'
           f'<div style="font-size:11px;color:{TXT_MUT};margin-bottom:6px;">{l}</div>'
           f'<div style="font-size:22px;font-weight:700;color:{c};">{v}</div></div>'
           for l,v,c in [("Bounties Held","7",TXT_PRI),("Total Collateral","~131,000 XMR",WARN),
                         ("Maturing < 5yr","3",SUCCESS),("Claims Active","2",ACCENT)])}
</div>"""
    grid = f"""<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
  {bounty_card("NYX-7F3A","SER-001 &middot; Unit 1/20","Archer Mwangi 2036","50,000 XMR","2036-04-23","ACTIVE",SUCCESS,SUCCESS_RGBA,1)}
  {bounty_card("NYX-2B91","SER-002 &middot; Unit 3/8","Priya Nakamura 2034","12,500 XMR","2034-11-01","CLAIMED",WARN,WARN_RGBA,1)}
  {bounty_card("NYX-91C3","SER-003 &middot; Unit 2/4","Sofia Reinholt 2040","25,000 XMR","2040-02-28","ACTIVE",SUCCESS,SUCCESS_RGBA,1)}
  {bounty_card("NYX-4401","SER-004 &middot; Units 1-3","Kenji Oduya Jr 2033","3x 5,000 XMR","2033-08-15","ACTIVE",SUCCESS,SUCCESS_RGBA,3)}
</div>"""
    return frame("HOLDER PORTFOLIO / OVERVIEW","My Bounty Portfolio", stats + sl("HELD BOUNTIES") + grid)

def f2():
    terms = (term_row(1,"qualitative","Subject achieves biological age of 50 verified by independent biometric panel") +
             term_row(2,"quantitative","VO2 max >= 45 mL/kg/min","gte","45","bio.vo2max") +
             term_row(3,"hybrid","DNA methylation age <= chronological age - 2 years"))
    left = f"""
<div style="background:{SURF};border:1px solid {BORDER};border-radius:10px;padding:18px 20px;margin-bottom:18px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
    <div>
      <div style="font-family:monospace;font-size:12px;color:{ACCENT};">NYX-7F3A-C20B-E941</div>
      <div style="font-size:18px;font-weight:700;color:{TXT_PRI};margin-top:2px;">Archer Mwangi 2036</div>
      <div style="font-size:11px;color:{TXT_MUT};margin-top:2px;">Series SER-001 &middot; Serial 001 &middot; schema v1.0</div>
    </div>
    {pill("ACTIVE",SUCCESS,SUCCESS_RGBA)}
  </div>
  {div()}
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;">
    {"".join(f'<div><div style="font-size:11px;color:{TXT_MUT};margin-bottom:3px;">{l}</div>'
             f'<div style="font-size:13px;font-weight:600;color:{c};">{v}</div></div>'
             for l,v,c in [("Collateral","50,000 XMR",WARN),("Denomination","XMR",TXT_PRI),
                           ("Issued","2026-04-23",TXT_PRI),("Deadline","2036-04-23",TXT_PRI),
                           ("Quorum","2-of-3 judges",ACCENT),("DLEQ Proof","Valid &#10003;",SUCCESS)])}
  </div>
</div>
{sl("BOND TERMS (AND)")}
{terms}
<div style="margin-top:6px;font-size:11px;color:{TXT_MUT};">All 3 terms must be met for payout (AND aggregation).</div>"""
    right = f"""<div style="background:{SURF};border:1px solid {BORDER};border-radius:10px;padding:18px 20px;">
  {sl("JUDGE PANEL")}
  {"".join(f'<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid {BORDER};">'
           f'<div><div style="font-size:12px;font-family:monospace;color:{ACCENT};">{k}</div>'
           f'<div style="font-size:11px;color:{TXT_MUT};">{r}</div></div>'
           f'<div style="font-size:11px;color:{TXT_MUT};">{f} XMR/attest</div></div>'
           for k,r,f in [("9dFk...3rPx","qualitative","0.5"),("7cD9...AA12","quantitative","0.3"),("2eF1...99B4","both","0.4")])}
  {div(14)}
  {sl("COLLATERAL LOCK")}
  <div style="font-size:12px;color:{TXT_MUT};margin-bottom:6px;">Lock TX</div>
  <div style="font-family:monospace;font-size:11px;color:{TXT_PRI};word-break:break-all;margin-bottom:14px;">0x3a9f...c1d2 (block 4,102,881)</div>
  {div(14)}
  <div style="display:flex;flex-direction:column;gap:8px;">
    {btn("File a Claim", color=ACCENT, text_color=TXT_PRI, full=True)}
    {btn_o("Transfer Bounty", full=True)}
    {btn_o("Export .bounty File", full=True)}
  </div>
</div>"""
    body = f'<div style="display:flex;gap:20px;align-items:flex-start;"><div style="flex:1;">{left}</div><div style="flex:0 0 280px;">{right}</div></div>'
    return frame("HOLDER PORTFOLIO / DETAIL","Bounty NYX-7F3A Detail", body)

def f3():
    note = f"""<div style="padding:12px 16px;background:{WARN_RGBA};border-left:3px solid {WARN};
              border-radius:0 6px 6px 0;font-size:12px;color:{TXT_SEC};margin-bottom:20px;">
  Transferring changes the bearer key embedded in the .bounty file. Once transferred,
  only the new bearer key can file claims or further transfer the bounty. This action is irreversible.</div>"""
    body = f"""
{inp("Bounty to Transfer","NYX-7F3A-C20B-E941  (Archer Mwangi 2036 &middot; 50,000 XMR)",mono=True)}
{div()}
{sl("RECIPIENT")}
{inp("Recipient's Public Key","New bearer Ed25519 pubkey (hex or base58)...",mono=True,
     note="The recipient must provide their public key before the transfer. They do not need to be online.")}
{inp("Delivery Method","",note="File can be sent via Tor, Signal, or physical media alongside the updated .bounty file")}
{note}
<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:8px;padding:14px 16px;margin-bottom:20px;">
  <div style="font-size:12px;font-weight:700;color:{TXT_PRI};margin-bottom:8px;">Transfer Summary</div>
  {"".join(f'<div style="display:flex;justify-content:space-between;margin-bottom:6px;">'
           f'<span style="font-size:12px;color:{TXT_MUT};">{l}</span>'
           f'<span style="font-size:12px;color:{TXT_PRI};">{v}</span></div>'
           for l,v in [("Bounty","NYX-7F3A-C20B-E941"),("Current bearer","7Ab2...88Fc (you)"),
                       ("New bearer","NEWBEARER00000001"),("Network fee","0.0001 XMR")])}
</div>
<div style="display:flex;gap:12px;">{btn_o("Cancel")} {btn("Sign & Transfer",color=ACCENT,text_color=TXT_PRI)}</div>"""
    return frame("HOLDER PORTFOLIO / TRANSFER","Transfer Bounty", body)

def f4():
    pre = f"""<div style="background:{SURF};border:1px solid {BORDER};border-radius:10px;padding:18px 20px;margin-bottom:20px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
    <div><div style="font-size:15px;font-weight:700;color:{TXT_PRI};">NYX-7F3A — Archer Mwangi 2036</div>
         <div style="font-size:11px;color:{TXT_MUT};margin-top:2px;">50,000 XMR &middot; Deadline 2036-04-23 &middot; Judge 9dFk...3rPx</div></div>
    {pill("ACTIVE",SUCCESS,SUCCESS_RGBA)}
  </div>
  <div style="padding:10px 14px;background:{ACCENT_RGBA};border-radius:6px;font-size:12px;color:{TXT_SEC};">
    This claim wizard is pre-filled with the selected bounty. You can modify any field before submitting.
  </div>
</div>"""
    steps = f"""<div style="display:flex;gap:0;margin-bottom:24px;background:{SURF};border:1px solid {BORDER};border-radius:8px;overflow:hidden;">
  {"".join(f'<div style="flex:1;padding:10px 14px;text-align:center;{"background:' + ACC_GLO + ';border-bottom:2px solid ' + ACCENT + ';'" if i==0 else ""}">'
           f'<div style="font-size:11px;font-weight:700;color:{"' + ACCENT + '" if i==0 else "' + TXT_MUT + '"};letter-spacing:0.5px;">{n}</div></div>'
           for i,n in enumerate(["1. SELECT BOUNTY","2. CLAIM TYPE","3. EVIDENCE","4. CONFIRM"]))}
</div>"""
    body = pre + steps + sl("CLAIM TYPE") + f"""
<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px;">
  {"".join(f'<div style="padding:12px 14px;background:{"' + ACC_GLO + '" if i==0 else SURF_HI};border:1px solid {"' + ACCENT + '" if i==0 else BORDER};border-radius:8px;cursor:pointer;">'
           f'<div style="font-size:13px;font-weight:600;color:{TXT_PRI};margin-bottom:3px;">{t}</div>'
           f'<div style="font-size:11px;color:{TXT_MUT};">{d}</div></div>'
           for i,(t,d) in enumerate([("Maturity Payout","All terms met, collateral due"),("Partial Payout","Terms partially met"),("Issuer Default","Issuer failed obligations"),("Expired","Bounty expired without settlement")]))}
</div>
<div style="display:flex;gap:12px;">{btn_o("Back to Portfolio")} {btn("Next: Evidence",color=ACCENT,text_color=TXT_PRI)}</div>"""
    return frame("HOLDER PORTFOLIO / FILE CLAIM","File a Claim", body)

def f5():
    hist_row = lambda bid,subj,c,date,reason,rc,rbg: f"""<div style="display:grid;grid-template-columns:120px 1fr 120px 110px 100px 70px;gap:12px;align-items:center;padding:11px 16px;background:{SURF};border:1px solid {BORDER};border-radius:8px;margin-bottom:8px;">
  <div style="font-family:monospace;font-size:11px;color:{ACCENT};">{bid}</div>
  <div style="font-size:13px;color:{TXT_PRI};">{subj}</div>
  <div style="font-size:13px;color:{WARN};font-weight:600;">{c}</div>
  <div style="font-size:12px;color:{TXT_MUT};">{date}</div>
  <div>{pill(reason,rc,rbg)}</div>
  <div style="text-align:right;">{btn_o("Details",small=True)}</div></div>"""
    rows = (hist_row("NYX-44EF","Kenji Oduya 2031","8,000 XMR","2026-02-14","APPROVED",SUCCESS,SUCCESS_RGBA) +
            hist_row("NYX-3301","Ana Lima 2028",   "5,000 XMR","2025-09-01","TRANSFERRED",ACCENT,ACCENT_RGBA) +
            hist_row("NYX-1102","Bo Zhang 2025",   "2,500 XMR","2025-01-15","EXPIRED",TXT_MUT,f"rgba(139,149,176,0.1)") +
            hist_row("NYX-0091","Maria V. 2024",   "1,000 XMR","2024-11-30","DENIED",DANGER,DANGER_RGBA))
    hdr_row = f'<div style="display:grid;grid-template-columns:120px 1fr 120px 110px 100px 70px;gap:12px;padding:8px 16px;margin-bottom:6px;"><div style="font-size:11px;color:{TXT_MUT};">BOND ID</div><div style="font-size:11px;color:{TXT_MUT};">SUBJECT</div><div style="font-size:11px;color:{TXT_MUT};">COLLATERAL</div><div style="font-size:11px;color:{TXT_MUT};">CLOSED</div><div style="font-size:11px;color:{TXT_MUT};">OUTCOME</div><div></div></div>'
    stats = f"""<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;">
  {"".join(f'<div style="background:{SURF};border:1px solid {BORDER};border-radius:8px;padding:14px 16px;">'
           f'<div style="font-size:11px;color:{TXT_MUT};margin-bottom:6px;">{l}</div>'
           f'<div style="font-size:22px;font-weight:700;color:{c};">{v}</div></div>'
           for l,v,c in [("Lifetime Received","16,500 XMR",WARN),("Approved","1",SUCCESS),("Denied","1",DANGER),("Transferred/Expired","2",TXT_MUT)])}
</div>"""
    return frame("HOLDER PORTFOLIO / HISTORY","Settlement History", stats + sl("CLOSED BOUNTIES") + hdr_row + rows)

FRAMES=[("Portfolio",f1),("Bounty Detail",f2),("Transfer",f3),("File Claim",f4),("History",f5)]

def build():
    tabs="".join(f'<button data-idx="{i}" aria-selected="{"true" if i==0 else "false"}" role="tab" '
                 f'style="padding:8px 18px;background:none;border:none;cursor:pointer;font-size:13px;'
                 f'font-weight:600;color:{"' + ACCENT + '" if i==0 else "' + TXT_MUT + '"};'
                 f'border-bottom:2px solid {"' + ACCENT + '" if i==0 else "transparent"};">'
                 f'{l}</button>' for i,(l,_) in enumerate(FRAMES))
    bodies="".join(f'<div data-frame="{i}" style="display:{"block" if i==0 else "none"};">{fn()}</div>'
                   for i,(_,fn) in enumerate(FRAMES))
    return f"""<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NyxForge Bounty Holder</title>
<style>*,*::before,*::after{{box-sizing:border-box;margin:0;padding:0}}
body{{background:{BG};color:{TXT_PRI};font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}}
::-webkit-scrollbar{{width:6px}}::-webkit-scrollbar-track{{background:{SURF}}}
::-webkit-scrollbar-thumb{{background:{INACT};border-radius:3px}}</style></head>
<body>
<div style="background:{SURF};border-bottom:1px solid {BORDER};padding:0 24px;position:sticky;top:0;z-index:100;">
  <div style="max-width:{FW+64}px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;">
    <div style="padding:12px 0;display:flex;align-items:center;gap:12px;">
      <div style="width:28px;height:28px;border-radius:6px;background:{ACC_GLO};display:flex;align-items:center;justify-content:center;font-family:monospace;font-size:11px;font-weight:700;color:{ACCENT};">NYX</div>
      <div style="font-size:14px;font-weight:700;color:{TXT_PRI};">Holder Portfolio</div>
    </div>
    <div style="display:flex;gap:0;" role="tablist">{tabs}</div>
    <div style="width:80px;"></div>
  </div>
</div>
<div style="position:fixed;bottom:20px;right:24px;z-index:200;display:flex;gap:8px;">
  <button onclick="nav(-1)" style="padding:8px 16px;background:{SURF_HI};border:1px solid {BORDER};border-radius:7px;color:{TXT_SEC};font-size:13px;cursor:pointer;">&larr; Prev</button>
  <button onclick="nav(1)"  style="padding:8px 16px;background:{SURF_HI};border:1px solid {BORDER};border-radius:7px;color:{TXT_SEC};font-size:13px;cursor:pointer;">Next &rarr;</button>
</div>
<div id="frames">{bodies}</div>
<script>
let cur=0;const tot={len(FRAMES)};
const fr=document.querySelectorAll('[data-frame]'),tb=document.querySelectorAll('[data-idx]');
function show(i){{fr[cur].style.display='none';tb[cur].style.color='{TXT_MUT}';tb[cur].style.borderBottomColor='transparent';
  cur=i;fr[cur].style.display='block';tb[cur].style.color='{ACCENT}';tb[cur].style.borderBottomColor='{ACCENT}';window.scrollTo(0,0);}}
function nav(d){{show((cur+d+tot)%tot);}}
tb.forEach(t=>t.addEventListener('click',()=>show(+t.dataset.idx)));
document.addEventListener('keydown',e=>{{if(e.key==='ArrowRight')nav(1);if(e.key==='ArrowLeft')nav(-1);}});
</script></body></html>"""

if __name__=="__main__":
    os.makedirs(OUTDIR,exist_ok=True)
    html=build()
    with open(OUTFILE,"w") as f: f.write(html)
    print(f"Written: {OUTFILE}  ({len(html):,} bytes)")