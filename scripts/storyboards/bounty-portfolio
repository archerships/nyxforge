TABS_JS = ",\n".join(f'"{t}"' for t, _ in FRAMES)
FRAMES_JS = ",\n".join(
    f'`{html.replace("`", "\\`").replace("${", "\\${")}`'
    for _, html in FRAMES
)

HTML = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>NyxForge Bounty Wallet Mockup</title>
<style>
* {{ box-sizing: border-box; margin: 0; padding: 0; }}
body {{ background: #080a12; font-family: 'Inter', system-ui, sans-serif;
       display: flex; flex-direction: column; align-items: center;
       min-height: 100vh; padding: 24px 16px; }}
.tab-bar {{ display: flex; gap: 4px; margin-bottom: 20px;
           background: {SURF}; border: 1px solid {BORDER};
           border-radius: 8px; padding: 4px; }}
.tab {{ padding: 7px 18px; border-radius: 6px; cursor: pointer;
       font-size: 13px; color: {TXT_MUT}; transition: all 0.15s; }}
.tab.active {{ background: {ACCENT}; color: {TXT_PRI}; font-weight: 700; }}
.tab:hover:not(.active) {{ color: {TXT_PRI}; }}
.viewport {{ display: flex; align-items: flex-start; justify-content: center;
            width: {FW}px; }}
.nav {{ display: flex; gap: 12px; margin-top: 16px; align-items: center; }}
.nav-btn {{ padding: 8px 20px; border-radius: 6px; cursor: pointer;
           font-size: 13px; background: {SURF}; border: 1px solid {BORDER};
           color: {TXT_SEC}; }}
.nav-btn:hover {{ border-color: {ACCENT}; color: {TXT_PRI}; }}
.frame-label {{ font-size: 12px; color: {TXT_MUT}; min-width: 120px; text-align: center; }}
</style>
</head>
<body>
<div class="tab-bar" id="tabBar"></div>
<div class="viewport" id="viewport"></div>
<div class="nav">
  <div class="nav-btn" onclick="go(-1)">&larr; Prev</div>
  <div class="frame-label" id="frameLabel"></div>
  <div class="nav-btn" onclick="go(1)">Next &rarr;</div>
</div>
<script>
const TABS   = [{TABS_JS}];
const FRAMES = [{FRAMES_JS}];
let cur = 0;
function render() {{
  const tb = document.getElementById('tabBar');
  tb.innerHTML = TABS.map((t,i) =>
    `<div class="tab${{i===cur?' active':''}}" onclick="jump(${{i}})">${{t}}</div>`
  ).join('');
  document.getElementById('viewport').innerHTML = FRAMES[cur];
  document.getElementById('frameLabel').textContent =
    (cur+1) + ' / ' + FRAMES.length + ' — ' + TABS[cur];
}}
function jump(i) {{ cur = i; render(); }}
function go(d) {{ cur = (cur + d + FRAMES.length) % FRAMES.length; render(); }}
render();
</script>
</body>
</html>"""

