          (f'<div style="width:16px;height:16px;border-radius:3px;background:{SURF};'
           f'border:2px solid {INACT};flex-shrink:0;"></div>')
    return (f'<div style="display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;">'
            f'{box}'
            f'<span style="font-size:13px;color:{TXT_SEC};line-height:1.5;">{label}</span>'
            f'</div>')

