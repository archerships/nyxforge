            f'<div style="width:10px;height:10px;border-radius:5px;background:{dot_bg};'
            f'flex-shrink:0;"></div>'
            f'<div style="flex:1;font-size:13px;color:{lbl_col};">{label}</div>'
            f'<div style="font-size:12px;color:{TXT_MUT};font-family:monospace;">{date}</div>'
