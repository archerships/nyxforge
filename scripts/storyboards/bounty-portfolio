            f'<div style="font-family:monospace;font-size:11px;color:{TXT_MUT};">{bounty_id}</div>'
            f'<div style="color:{TXT_PRI};">{name}</div>'
            f'<div style="color:{TXT_SEC};text-align:right;">{amount}</div>'
            f'<div style="color:{TXT_MUT};font-family:monospace;text-align:right;">{collateral}</div>'
            f'<div>{status_pill(status, status_color, status_bg)}</div>'
            f'<div style="color:{TXT_MUT};font-size:11px;">{deadline}</div>'
            f'</div>')

