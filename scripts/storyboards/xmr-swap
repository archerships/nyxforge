def step_node(n, label, state):
    if state == "done":
        bg, brd, ncol, lcol = ACC_GLO, ACCENT, ACCENT, TXT_SEC
        sym = "&#10003;"
    elif state == "active":
        bg, brd, ncol, lcol = ACC_GLO, ACCENT, TXT_PRI, TXT_PRI
        sym = str(n)
    else:
        bg, brd, ncol, lcol = SURF_HI, INACT, TXT_MUT, TXT_MUT
        sym = str(n)
    return (f'<div style="display:flex;flex-direction:column;align-items:center;gap:6px;">'
            f'<div style="width:30px;height:30px;border-radius:50%;background:{bg};'
            f'border:2px solid {brd};display:flex;align-items:center;justify-content:center;'
            f'font-size:12px;font-weight:700;color:{ncol};">{sym}</div>'
            f'<div style="font-size:11px;color:{lcol};white-space:nowrap;">{label}</div>'
            f'</div>')

def step_connector(done=False):
    col = ACCENT if done else INACT
    return (f'<div style="flex:1;height:2px;background:{col};'
            f'align-self:flex-start;margin-top:14px;"></div>')

