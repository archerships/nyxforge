# ---------------------------------------------------------------------------
# Price curve SVG
# ---------------------------------------------------------------------------

def price_curve_svg(w=580, h=180, pct_elapsed=0.38, pct_filled=0.61):
    """
    Render a descending exponential price curve.
    pct_elapsed: how far along the time axis we are (0-1)
    pct_filled:  what fraction of units are sold
    """
    pad_l, pad_r, pad_t, pad_b = 44, 16, 14, 36
    cw = w - pad_l - pad_r
    ch = h - pad_t - pad_b

    # Curve: exponential decay  price = start * e^(-k*t), normalised 0..1
    # start_price=200, floor_price=40, over t=1
    p_start, p_floor = 200, 40
    k = math.log(p_start / p_floor)   # so that at t=1, price = p_floor

    def price_at(t):
        return p_start * math.exp(-k * t)

    def y_for_price(p):
        return pad_t + ch * (1 - (p - p_floor) / (p_start - p_floor))

    def x_for_t(t):
        return pad_l + cw * t

    # Build curve polyline
    pts = []
    for i in range(101):
        t = i / 100
        p = price_at(t)
        pts.append(f"{x_for_t(t):.1f},{y_for_price(p):.1f}")
    curve = " ".join(pts)

    # Filled area under curve up to current time
    fill_pts = [(pad_l, pad_t + ch)]
    for i in range(int(pct_elapsed * 100) + 1):
        t = i / 100
        p = price_at(t)
        fill_pts.append((x_for_t(t), y_for_price(p)))
    fill_pts.append((x_for_t(pct_elapsed), pad_t + ch))
    fill_poly = " ".join(f"{x:.1f},{y:.1f}" for x, y in fill_pts)

    # Current price
    cur_price = price_at(pct_elapsed)
    cx = x_for_t(pct_elapsed)
    cy = y_for_price(cur_price)

    # Y-axis labels
    y_labels = ""
    for p_val in [200, 160, 120, 80, 40]:
        yy = y_for_price(p_val)
        y_labels += (f'<text x="{pad_l - 6}" y="{yy + 4}" '
                     f'text-anchor="end" font-size="10" fill="{TXT_MUT}">${int(p_val)}</text>')

    # X-axis labels
    x_labels = ""
    for label, t in [("0h", 0), ("18h", 0.25), ("36h", 0.5), ("54h", 0.75), ("72h", 1.0)]:
        xx = x_for_t(t)
        x_labels += (f'<text x="{xx}" y="{pad_t + ch + 18}" '
                     f'text-anchor="middle" font-size="10" fill="{TXT_MUT}">{label}</text>')

    # Grid lines
    grid = ""
    for p_val in [160, 120, 80]:
        yy = y_for_price(p_val)
        grid += (f'<line x1="{pad_l}" y1="{yy}" x2="{pad_l + cw}" y2="{yy}" '
                 f'stroke="{BORDER}" stroke-width="1"/>')

    # Floor price dashed line
    yfloor = y_for_price(p_floor)
    grid += (f'<line x1="{pad_l}" y1="{yfloor}" x2="{pad_l + cw}" y2="{yfloor}" '
             f'stroke="{INACT}" stroke-width="1" stroke-dasharray="4,3"/>')

    # Current time vertical line
    grid += (f'<line x1="{cx}" y1="{pad_t}" x2="{cx}" y2="{pad_t + ch}" '
             f'stroke="{ACCENT}" stroke-width="1" stroke-dasharray="3,3"/>')

    # Current price label
    cur_label = (f'<rect x="{cx + 6}" y="{cy - 12}" width="56" height="20" '
                 f'rx="4" fill="{ACC_GLO}" stroke="{ACCENT}" stroke-width="1"/>'
                 f'<text x="{cx + 34}" y="{cy + 2}" text-anchor="middle" '
                 f'font-size="11" font-weight="700" fill="{ACCENT}">'
                 f'${cur_price:.0f}</text>')

    return f"""
<svg width="{w}" height="{h}" xmlns="http://www.w3.org/2000/svg"
     style="display:block;">
  <!-- grid -->
  {grid}
  <!-- y-axis -->
  <line x1="{pad_l}" y1="{pad_t}" x2="{pad_l}" y2="{pad_t+ch}"
        stroke="{BORDER}" stroke-width="1"/>
  <!-- x-axis -->
  <line x1="{pad_l}" y1="{pad_t+ch}" x2="{pad_l+cw}" y2="{pad_t+ch}"
        stroke="{BORDER}" stroke-width="1"/>
  <!-- fill area -->
  <polygon points="{fill_poly}" fill="{ACCENT}" opacity="0.12"/>
  <!-- curve -->
  <polyline points="{curve}" fill="none" stroke="{ACCENT}" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round"/>
  <!-- current dot -->
  <circle cx="{cx}" cy="{cy}" r="5" fill="{ACCENT}" stroke="{BG}" stroke-width="2"/>
  <!-- labels -->
  {y_labels}
  {x_labels}
  {cur_label}
  <!-- floor label -->
  <text x="{pad_l + cw + 4}" y="{yfloor + 4}"
        font-size="9" fill="{INACT}">floor</text>
</svg>"""

