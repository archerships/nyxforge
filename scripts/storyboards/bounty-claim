          timeline_step("Under Review",              "In progress",           False, True) +
          timeline_step("Verdict",                   "Est. 2026-05-10",       False))
    msg = f"""<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:8px;padding:14px 16px;margin-bottom:12px;">
  <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
    <span style="font-size:12px;font-weight:700;color:{ACCENT};">Judge 9dFk...3rPx</span>
    <span style="font-size:11px;color:{TXT_MUT};">2026-04-25 09:14 UTC</span></div>
