    tl = (timeline_step("Claim Filed",               "2026-04-23 14:31 UTC", True) +
          timeline_step("Evidence Verified",         "2026-04-23 14:45 UTC", True) +
          timeline_step("Assigned to Judge 9dFk...", "2026-04-23 15:02 UTC", True) +
          timeline_step("Judge Requested More Info", "2026-04-25 09:14 UTC", True) +
