#!/usr/bin/env python3
"""
NyxForge Bounty Claim mockup generator (claimant side).
Generates docs/storyboards/out/bounty-claim-mockup.html

5 frames:
  1. My Claims     -- list of claims filed by this holder
  2. File Claim    -- select .bounty, claim type, narrative
  3. Attach Evidence -- upload PDF/video/JSON attestation docs
  4. Claim Status  -- live status, judge messages, timeline
  5. Withdraw      -- cancel a pending claim before verdict
"""
import os

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
OUTDIR     = os.path.join(os.environ.get("NYXFORGE_ROOT", os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))), "docs/storyboards/out")
OUTFILE    = os.path.join(OUTDIR, "bounty-claim-mockup.html")

BG      = "#0d0f1a"; SURF    = "#131524"; SURF_HI = "#1a1d2e"
ACCENT  = "#5e6ad2"; ACC_GLO = "#2d3068"; TXT_PRI = "#e8eaf0"
TXT_SEC = "#b8c0d8"; TXT_MUT = "#8b95b0"; SUCCESS = "#4ade80"
DANGER  = "#f87171"; WARN    = "#fbbf24"; BORDER  = "#2a2d3e"
INACT   = "#3a3d5c"
SUCCESS_RGBA = "rgba(74,222,128,0.10)"; WARN_RGBA = "rgba(251,191,36,0.10)"
ACCENT_RGBA  = "rgba(94,106,210,0.12)"; DANGER_RGBA = "rgba(248,113,113,0.10)"
FW = 920

def sl(t):
    return f'<div style="font-size:11px;font-weight:700;letter-spacing:1.2px;color:{ACCENT};margin-bottom:8px;">{t}</div>'
def div(mb=12):
    return f'<div style="height:1px;background:{BORDER};margin:0 0 {mb}px;"></div>'
def pill(t, c, bg):
    return f'<span style="font-size:10px;font-weight:700;letter-spacing:0.8px;padding:3px 9px;border-radius:4px;color:{c};background:{bg};">{t}</span>'
def btn(l, color=SUCCESS, text_color=BG, small=False, full=False):
    p = "7px 16px" if small else "13px 28px"; fs = "12px" if small else "14px"
    w = "width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return f'<div style="{w}padding:{p};background:{color};border-radius:7px;font-size:{fs};font-weight:700;color:{text_color};cursor:pointer;">{l}</div>'
def btn_o(l, small=False, color=None, full=False):
    p = "6px 14px" if small else "12px 27px"; fs = "12px" if small else "14px"
    col = color or TXT_SEC; brd = color or BORDER
    w = "width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return f'<div style="{w}padding:{p};background:transparent;border:1px solid {brd};border-radius:7px;font-size:{fs};color:{col};cursor:pointer;">{l}</div>'
def inp(label, val, mono=False, note=None):
    f = "monospace" if mono else "inherit"
    n = f'<div style="font-size:11px;color:{TXT_MUT};margin-top:4px;">{note}</div>' if note else ""
    return (f'<div style="margin-bottom:12px;">'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">{label}</div>'
            f'<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:6px;'
            f'padding:9px 13px;font-size:13px;color:{TXT_MUT};font-family:{f};">{val}</div>{n}</div>')
def hdr():
    return f"""<div style="background:{SURF};border-bottom:1px solid {BORDER};padding:13px 24px;
              display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:14px;">
      <div style="width:28px;height:28px;border-radius:6px;background:{ACC_GLO};display:flex;align-items:center;
                  justify-content:center;font-size:11px;font-weight:700;color:{ACCENT};">NYX</div>
      <div><div style="font-size:15px;font-weight:700;color:{TXT_PRI};">Claim Filing</div>
           <div style="font-size:11px;color:{TXT_MUT};">Submit and track bounty claims</div></div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;">
      <div style="font-size:12px;font-family:monospace;color:{TXT_MUT};">7Ab2...88Fc</div>
      {btn("+ File Claim", color=ACCENT, text_color=TXT_PRI, small=True)}
    </div></div>"""

def frame(title, sub, body):
    return f"""<div style="background:{BG};min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  {hdr()}
  <div style="max-width:{FW}px;margin:0 auto;padding:28px 32px;">
    <div style="margin-bottom:22px;">
      <div style="font-size:11px;font-weight:700;letter-spacing:1.2px;color:{ACCENT};margin-bottom:4px;text-transform:uppercase;">{title}</div>
      <div style="font-size:22px;font-weight:700;color:{TXT_PRI};">{sub}</div>
    </div>
    {body}
  </div></div>"""

def claim_row(cid, bounty_id, bounty_subj, filed, status, sc, bg, deadline=""):
    dl = f'<span style="font-size:11px;color:{TXT_MUT};">{deadline}</span>' if deadline else ""
    return f"""<div style="display:grid;grid-template-columns:130px 140px 1fr 110px 130px 80px;
              gap:12px;align-items:center;padding:12px 16px;background:{SURF};
              border:1px solid {BORDER};border-radius:8px;margin-bottom:8px;">
  <div style="font-family:monospace;font-size:12px;color:{ACCENT};">{cid}</div>
  <div style="font-family:monospace;font-size:11px;color:{TXT_MUT};">{bounty_id}</div>
  <div style="font-size:13px;color:{TXT_PRI};">{bounty_subj}</div>
  <div style="font-size:12px;color:{TXT_MUT};">{filed}</div>
  <div>{pill(status, sc, bg)}{dl}</div>
  <div style="text-align:right;">{btn_o("View", small=True)}</div></div>"""

def evidence_card(num, name, ftype, size, status, sc):
    icon = {"PDF": "&#x1F4C4;", "MP4": "&#x1F3A5;", "JSON": "&#x7B7D;"}.get(ftype, "&#x1F4CE;")
    return f"""<div style="display:flex;align-items:center;gap:14px;padding:12px 16px;
              background:{SURF_HI};border:1px solid {BORDER};border-radius:8px;margin-bottom:8px;">
  <div style="font-size:20px;">{icon}</div>
  <div style="flex:1;">
    <div style="font-size:13px;color:{TXT_PRI};font-weight:600;">[{num}] {name}</div>
    <div style="font-size:11px;color:{TXT_MUT};margin-top:2px;">{ftype} &middot; {size}</div>
  </div>
  <div>{pill(status, sc, SUCCESS_RGBA if sc == SUCCESS else ACCENT_RGBA)}</div>
  <div style="font-size:11px;color:{DANGER};cursor:pointer;">Remove</div></div>"""

def timeline_step(label, date, done=True, active=False):
    dot_c = SUCCESS if done else (ACCENT if active else INACT)
    txt_c = TXT_PRI if (done or active) else TXT_MUT
    return f"""<div style="display:flex;gap:14px;margin-bottom:16px;align-items:flex-start;">
  <div style="flex:0 0 auto;width:12px;height:12px;border-radius:50%;background:{dot_c};margin-top:3px;"></div>
  <div>
    <div style="font-size:13px;color:{txt_c};font-weight:600;">{label}</div>
    <div style="font-size:11px;color:{TXT_MUT};margin-top:2px;">{date}</div>
  </div></div>"""

# ---------------------------------------------------------------------------
# Frames
# ---------------------------------------------------------------------------

def f1():
    rows = (
        claim_row("CLM-0044", "NYX-7F3A", "Archer Mwangi 2036",   "2026-04-23", "REVIEW",   WARN,    WARN_RGBA,   "30d left") +
        claim_row("CLM-0038", "NYX-2B91", "Priya Nakamura 2034",  "2026-03-28", "EVIDENCE", ACCENT,  ACCENT_RGBA, "22d left") +
        claim_row("CLM-0031", "NYX-44EF", "Kenji Oduya 2031",     "2026-02-14", "APPROVED", SUCCESS, SUCCESS_RGBA) +
        claim_row("CLM-0022", "NYX-91C3", "Sofia Reinholt 2040",  "2025-11-10", "DENIED",   DANGER,  DANGER_RGBA)
    )
    stats = f"""<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px;">
  {"".join(f'<div style="background:{SURF};border:1px solid {BORDER};border-radius:8px;padding:14px 16px;">'
           f'<div style="font-size:11px;color:{TXT_MUT};margin-bottom:6px;">{l}</div>'
           f'<div style="font-size:22px;font-weight:700;color:{c};">{v}</div></div>'
           for l, v, c in [("Total Claims","4",TXT_PRI),("In Review","2",WARN),("Approved","1",SUCCESS),("Denied","1",DANGER)])}
</div>"""
    hdr_row = f'<div style="display:grid;grid-template-columns:130px 140px 1fr 110px 130px 80px;gap:12px;padding:8px 16px;margin-bottom:6px;"><div style="font-size:11px;color:{TXT_MUT};">CLAIM ID</div><div style="font-size:11px;color:{TXT_MUT};">BOUNTY ID</div><div style="font-size:11px;color:{TXT_MUT};">SUBJECT</div><div style="font-size:11px;color:{TXT_MUT};">FILED</div><div style="font-size:11px;color:{TXT_MUT};">STATUS</div><div></div></div>'
    return frame("BOUNTY CLAIM / MY CLAIMS", "Claims Filed by You",
                 stats + sl("ACTIVE CLAIMS") + hdr_row + rows)

