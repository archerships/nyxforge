def sparkline(pts, w=100, h=32, c=SUCCESS):
    lo,hi=min(pts),max(pts)
    rng=hi-lo or 1
    xs=[i/(len(pts)-1)*w for i in range(len(pts))]
    ys=[(1-(p-lo)/rng)*(h-4)+2 for p in pts]
    path="M "+(" L ".join(f"{x:.1f},{y:.1f}" for x,y in zip(xs,ys)))
    fill_path=path+f" L {w},{ h} L 0,{h} Z"
    return f'<svg width="{w}" height="{h}" viewBox="0 0 {w} {h}"><defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="{c}" stop-opacity="0.3"/><stop offset="100%" stop-color="{c}" stop-opacity="0"/></linearGradient></defs><path d="{fill_path}" fill="url(#sg)"/><path d="{path}" fill="none" stroke="{c}" stroke-width="1.5"/></svg>'

