        {sub}
      </div>
    </div>
    <div style="font-size:11px;color:{INACT};">NyxForge Judge Portal</div>
  </div>"""

def progress_bar(steps, current):
    items = []
    for i, label in enumerate(steps):
        n     = i + 1
        done  = n < current
        active= n == current
        dot_bg    = SUCCESS if done else (ACCENT if active else INACT)
        dot_border= SUCCESS if done else (ACCENT if active else INACT)
        dot_inner = f'<div style="width:8px;height:8px;border-radius:4px;background:{BG};"></div>' if done else ""
        lbl_color = TXT_PRI if active else (TXT_SEC if done else TXT_MUT)
        line_color= SUCCESS if done else BORDER
        line = (f'<div style="flex:1;height:2px;background:{line_color};margin-top:11px;"></div>'
                if i < len(steps)-1 else "")
        items.append(
            f'<div style="display:flex;flex-direction:column;align-items:center;gap:4px;">'
            f'<div style="width:22px;height:22px;border-radius:11px;background:{dot_bg};'
            f'border:2px solid {dot_border};display:flex;align-items:center;'
            f'justify-content:center;">{dot_inner}</div>'
            f'<div style="font-size:10px;color:{lbl_color};white-space:nowrap;">{label}</div>'
            f'</div>{line}'
        )
    return (f'<div style="display:flex;align-items:flex-start;padding:14px 24px 6px;">'
            + "".join(items) + '</div>')

