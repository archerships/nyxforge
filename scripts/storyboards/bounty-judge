#!/usr/bin/env python3
"""
NyxForge Judge Onboarding mockup generator.
Generates docs/storyboards/out/bounty-judge-mockup.html

6 frames:
  1. Invitation Landing    -- bounty summary, proposed role, Accept / Decline
  2. Create Judge Profile  -- name/org/bio pre-filled, photo, keypair generation
  3. Review Bounty & Terms   -- full terms, timeline, responsibility agreement, sign
  4. Setup Complete        -- confirmation, judge card preview, dashboard link
  5. Judge Dashboard       -- assigned bounties, status per bounty
  6. Verdict Submission    -- evidence review, data feed / expert verdict, sign & submit
"""
