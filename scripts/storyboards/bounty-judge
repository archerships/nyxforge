def section_label(text):
    return (f'<div style="font-size:11px;font-weight:700;letter-spacing:1.2px;'
            f'color:{ACCENT};margin-bottom:8px;">{text}</div>')

def divider(mb=12):
    return f'<div style="height:1px;background:{BORDER};margin:0 0 {mb}px;"></div>'

def step_circle(n, active=True):
    bg    = ACC_GLO if active else SURF_HI
    color = ACCENT  if active else TXT_MUT
    return (f'<div style="width:28px;height:28px;border-radius:14px;background:{bg};'
            f'flex-shrink:0;display:flex;align-items:center;justify-content:center;'
            f'font-size:12px;font-weight:700;color:{color};">{n}</div>')

def check_row(label, checked=False):
    box = (f'<div style="width:16px;height:16px;border-radius:3px;background:{ACC_GLO};'
           f'border:2px solid {ACCENT};flex-shrink:0;display:flex;align-items:center;'
           f'justify-content:center;font-size:10px;color:{SUCCESS};">&#10003;</div>')  if checked else \
          (f'<div style="width:16px;height:16px;border-radius:3px;background:{SURF};'
           f'border:2px solid {INACT};flex-shrink:0;"></div>')
    return (f'<div style="display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;">'
            f'{box}'
            f'<span style="font-size:13px;color:{TXT_SEC};line-height:1.5;">{label}</span>'
            f'</div>')

def input_field(label, value, mono=False):
    font = "monospace" if mono else "inherit"
    return (f'<div style="margin-bottom:10px;">'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">{label}</div>'
            f'<div style="background:{SURF};border:1px solid {BORDER};border-radius:6px;'
            f'padding:9px 13px;font-size:13px;color:{TXT_SEC};font-family:{font};">{value}</div>'
            f'</div>')

def btn(label, color=SUCCESS, text_color=BG, small=False):
    pad = "8px 18px" if small else "13px 28px"
    fs  = "12px"     if small else "14px"
    return (f'<div style="display:inline-block;padding:{pad};background:{color};'
            f'border-radius:8px;font-size:{fs};font-weight:700;color:{text_color};'
            f'cursor:pointer;letter-spacing:0.3px;">{label}</div>')

def btn_outline(label, small=False):
    pad = "7px 17px" if small else "12px 27px"
    fs  = "12px"     if small else "14px"
    return (f'<div style="display:inline-block;padding:{pad};background:transparent;'
            f'border:1px solid {BORDER};border-radius:8px;font-size:{fs};'
            f'color:{TXT_SEC};cursor:pointer;">{label}</div>')

def status_pill(text, color, bg):
    return (f'<span style="font-size:10px;font-weight:700;letter-spacing:0.8px;'
            f'padding:3px 8px;border-radius:4px;color:{color};background:{bg};">'
            f'{text}</span>')

def nyx_header(title, subtitle=None):
    sub = (f'<div style="font-size:11px;color:{TXT_MUT};margin-top:2px;">{subtitle}</div>'
           if subtitle else "")
    return f"""
  <div style="background:{SURF};border-bottom:1px solid {BORDER};padding:14px 24px;
              display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="width:28px;height:28px;border-radius:6px;background:{ACC_GLO};
                  display:flex;align-items:center;justify-content:center;
                  font-size:11px;font-weight:700;color:{ACCENT};">NYX</div>
