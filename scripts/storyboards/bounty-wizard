# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def section_label(text):
    return (f'<div style="font-size:11px;font-weight:700;letter-spacing:1.2px;'
            f'color:{ACCENT};margin-bottom:8px;">{text}</div>')

def divider(mb=12):
    return f'<div style="height:1px;background:{BORDER};margin:0 0 {mb}px;"></div>'

def input_field(label, value, mono=False, height=44, help_tip=False):
    font = "monospace" if mono else "inherit"
    tip  = (f'<span style="display:inline-block;width:15px;height:15px;border-radius:8px;'
            f'background:{ACC_GLO};border:1px solid {ACCENT};font-size:10px;font-weight:700;'
            f'color:{ACCENT};text-align:center;line-height:15px;margin-left:6px;">?</span>'
            if help_tip else "")
    return (f'<div style="margin-bottom:14px;">'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-bottom:5px;">{label}{tip}</div>'
            f'<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:6px;'
            f'padding:0 14px;height:{height}px;display:flex;align-items:center;'
            f'font-size:13px;color:{TXT_MUT};font-family:{font};">{value}</div>'
            f'</div>')

def textarea_field(label, value, rows=3):
    lh = rows * 22 + 16
    return (f'<div style="margin-bottom:14px;">'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-bottom:5px;">{label}</div>'
            f'<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:6px;'
            f'padding:10px 14px;min-height:{lh}px;font-size:13px;color:{TXT_MUT};'
            f'line-height:1.6;">{value}</div>'
            f'</div>')

def btn(label, color=SUCCESS, text_color=BG, small=False):
    pad = "8px 18px" if small else "12px 26px"
    fs  = "12px"     if small else "14px"
    return (f'<div style="display:inline-block;padding:{pad};background:{color};'
            f'border-radius:7px;font-size:{fs};font-weight:700;color:{text_color};'
            f'cursor:pointer;letter-spacing:0.3px;">{label}</div>')

def btn_outline(label, small=False):
    pad = "7px 17px" if small else "11px 25px"
    fs  = "12px"     if small else "14px"
    return (f'<div style="display:inline-block;padding:{pad};background:transparent;'
            f'border:1px solid {INACT};border-radius:7px;font-size:{fs};'
            f'color:{TXT_SEC};cursor:pointer;">{label}</div>')

def tab_toggle(labels, active_idx):
    items = []
    for i, lbl in enumerate(labels):
        if i == active_idx:
            items.append(
                f'<div style="flex:1;padding:8px;background:{ACCENT};border-radius:5px;'
                f'text-align:center;font-size:13px;font-weight:700;color:{TXT_PRI};">'
                f'{lbl}</div>')
        else:
            items.append(
                f'<div style="flex:1;padding:8px;background:transparent;border-radius:5px;'
                f'text-align:center;font-size:13px;color:{TXT_MUT};cursor:pointer;">'
                f'{lbl}</div>')
    return (f'<div style="display:flex;gap:4px;background:{SURF_HI};border:1px solid {BORDER};'
            f'border-radius:7px;padding:4px;margin-bottom:4px;">'
            + "".join(items) + '</div>')

def help_note(text):
    return (f'<div style="font-size:11px;color:{TXT_MUT};margin-top:-8px;'
            f'margin-bottom:14px;">{text}</div>')

def wizard_header(title, subtitle):
    return f"""
  <div style="padding:18px 24px 14px;border-bottom:1px solid {BORDER};">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:4px;">
      <div style="width:28px;height:28px;border-radius:6px;background:{ACC_GLO};
                  display:flex;align-items:center;justify-content:center;
                  font-size:11px;font-weight:700;color:{ACCENT};">NYX</div>
      <div style="font-size:18px;font-weight:700;color:{TXT_PRI};">{title}</div>
    </div>
    <div style="font-size:13px;color:{TXT_MUT};padding-left:40px;">{subtitle}</div>
  </div>"""

def progress_stepper(steps, current):
    items = []
    n = len(steps)
    for i, lbl in enumerate(steps):
        step_n = i + 1
        done   = step_n < current
        active = step_n == current
        if done:
            dot_bg  = ACC_GLO
            dot_brd = ACCENT
            num_col = ACCENT
            lbl_col = TXT_SEC
            num_txt = "&#10003;"
        elif active:
            dot_bg  = ACCENT
            dot_brd = ACCENT
            num_col = BG
            lbl_col = TXT_PRI
            num_txt = str(step_n)
        else:
            dot_bg  = SURF_HI
            dot_brd = INACT
            num_col = TXT_MUT
            lbl_col = TXT_MUT
            num_txt = str(step_n)

        dot = (f'<div style="width:26px;height:26px;border-radius:13px;'
               f'background:{dot_bg};border:2px solid {dot_brd};'
               f'display:flex;align-items:center;justify-content:center;'
               f'font-size:11px;font-weight:700;color:{num_col};flex-shrink:0;">'
               f'{num_txt}</div>')
        label_el = (f'<div style="font-size:11px;color:{lbl_col};'
                    f'font-weight:{"700" if active else "400"};'
                    f'margin-top:5px;white-space:nowrap;">{lbl}</div>')
        connector = ""
        if i < n - 1:
            connector = (f'<div style="flex:1;height:2px;background:{BORDER};'
                         f'margin:0 2px;margin-top:-13px;"></div>')
        items.append(
            f'<div style="display:flex;flex-direction:column;align-items:center;">'
            f'{dot}{label_el}</div>')
        if connector:
            items.append(
                f'<div style="flex:1;height:2px;background:{BORDER};'
                f'align-self:flex-start;margin-top:12px;"></div>')

    return (f'<div style="display:flex;align-items:flex-start;padding:14px 24px 10px;'
            f'border-bottom:1px solid {BORDER};">'
            + "".join(items) + '</div>')

STEPS = ["Description", "Terms", "Timing", "Collateral", "Judges", "Review"]

def footer(step):
    back = btn_outline("BACK") if step > 1 else \
           f'<div style="width:94px;"></div>'
    fwd_label = "CREATE BOUNTY" if step == 6 else "NEXT"
    fwd_color = SUCCESS if step == 6 else ACCENT
    fwd_tcol  = BG if step == 6 else TXT_PRI
    return f"""
  <div style="border-top:1px solid {BORDER};padding:14px 24px;
              display:flex;align-items:center;justify-content:space-between;">
    {back}
    <div style="font-size:12px;color:{TXT_MUT};">Step {step} of 6</div>
    {btn(fwd_label, color=fwd_color, text_color=fwd_tcol)}
  </div>"""

def frame(fh, current_step, content):
    return (f'<div class="frame" style="width:{FW}px;min-height:{fh}px;background:{BG};'
            f'border:1px solid {BORDER};border-radius:10px;overflow:hidden;'
            f'display:flex;flex-direction:column;">'
            + wizard_header("Create Bounty", "")
            + progress_stepper(STEPS, current_step)
            + f'<div style="flex:1;padding:20px 24px;">{content}</div>'
            + footer(current_step)
            + '</div>')

