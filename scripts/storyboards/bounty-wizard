#!/usr/bin/env python3
"""
NyxForge Bounty Creation Wizard mockup generator.
Generates docs/storyboards/out/bounty-wizard-mockup.html

6 steps (NGO / issuer perspective):
  1. Description  -- bounty title, description, bearer warning
  2. Terms        -- quantitative / qualitative, criterion, threshold, + ADD TERM
  3. Timing       -- deadline, expiry, grace period, example timeline
  4. Collateral   -- currency, lock mechanism, amount/file, file count, summary
  5. Judges      -- judge pubkey, role, quorum, challenge period, settlement flow
  6. Review       -- full summary before writing .bounty files
"""
