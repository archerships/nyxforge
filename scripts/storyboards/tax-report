def section_label(text):
    return (f'<div style="font-size:11px;font-weight:700;letter-spacing:1.2px;'
            f'color:{ACCENT};margin-bottom:8px;">{text}</div>')

def status_pill(text, color, bg):
    return (f'<span style="font-size:10px;font-weight:700;letter-spacing:0.8px;'
            f'padding:3px 9px;border-radius:4px;color:{color};background:{bg};">'
            f'{text}</span>')

def btn(label, color=SUCCESS, text_color=BG, small=False, full=False):
    pad = "7px 14px" if small else "13px 28px"
    fs  = "12px"    if small else "14px"
    wid = "width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return (f'<div style="{wid}padding:{pad};background:{color};'
            f'border-radius:7px;font-size:{fs};font-weight:700;color:{text_color};'
            f'cursor:pointer;letter-spacing:0.3px;">{label}</div>')

def btn_outline(label, small=False, color=None, full=False):
    pad  = "6px 13px" if small else "12px 27px"
    fs   = "12px"     if small else "14px"
    col  = color or TXT_SEC
    bord = color or BORDER
    wid  = "width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return (f'<div style="{wid}padding:{pad};background:transparent;'
            f'border:1px solid {bord};border-radius:7px;font-size:{fs};'
            f'color:{col};cursor:pointer;">{label}</div>')

def input_field(label, value, mono=False, note=None):
    font = "monospace" if mono else "inherit"
    n = (f'<div style="font-size:11px;color:{TXT_MUT};margin-top:4px;">{note}</div>'
         if note else "")
    return (f'<div style="margin-bottom:12px;">'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">{label}</div>'
            f'<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:6px;'
            f'padding:9px 13px;font-size:13px;color:{TXT_MUT};font-family:{font};">{value}</div>'
            f'{n}</div>')

def stat_card(label, value, sub, value_color=TXT_PRI):
    return (f'<div style="background:{SURF};border:1px solid {BORDER};border-radius:8px;'
            f'padding:14px 16px;flex:1;">'
            f'<div style="font-size:11px;color:{TXT_MUT};margin-bottom:6px;">{label}</div>'
            f'<div style="font-size:22px;font-weight:700;color:{value_color};">{value}</div>'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-top:3px;">{sub}</div>'
