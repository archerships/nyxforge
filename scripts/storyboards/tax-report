    </div>
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="font-size:12px;color:{TXT_MUT};">Tax year:</div>
      {''.join(
        f'<div style="padding:4px 12px;border-radius:5px;font-size:12px;cursor:pointer;'
        f'background:{"" + ACC_GLO if y == "2025" else SURF_HI};'
        f'border:1px solid {"" + ACCENT if y == "2025" else BORDER};'
        f'color:{"" + TXT_PRI if y == "2025" else TXT_MUT};">{y}</div>'
