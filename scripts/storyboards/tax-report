      )}
    </div>
  </div>"""

def nav_tabs(active):
    tabs = ["Overview", "Donations", "Crypto Ledger", "Generate", "Receipts"]
    items = "".join(
        f'<div style="padding:10px 20px;font-size:13px;cursor:pointer;'
        f'color:{"" + TXT_PRI if t == active else TXT_MUT};'
        f'border-bottom:{"2px solid " + ACCENT if t == active else "2px solid transparent"};'
        f'font-weight:{"700" if t == active else "400"};">{t}</div>'
        for t in tabs
    )
    return (f'<div style="display:flex;border-bottom:1px solid {BORDER};'
            f'background:{SURF};padding:0 24px;">{items}</div>')

