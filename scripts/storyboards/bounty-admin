DANGER_RGBA  = "rgba(248,113,113,0.10)"
WARN_RGBA    = "rgba(251,191,36,0.10)"

FW  = 1100
SBW = 196   # sidebar width

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def section_label(text):
    return (f'<div style="font-size:11px;font-weight:700;letter-spacing:1.2px;'
            f'color:{ACCENT};margin-bottom:8px;">{text}</div>')

def divider(mb=12):
    return f'<div style="height:1px;background:{BORDER};margin:0 0 {mb}px;"></div>'

def stat_card(label, value, sub=None, color=None):
    vc = color or TXT_PRI
    sub_html = (f'<div style="font-size:11px;color:{TXT_MUT};margin-top:3px;">{sub}</div>'
                if sub else "")
    return (f'<div style="background:{SURF};border:1px solid {BORDER};border-radius:8px;'
            f'padding:16px 20px;flex:1;">'
            f'<div style="font-size:11px;color:{TXT_MUT};margin-bottom:6px;">{label}</div>'
            f'<div style="font-size:26px;font-weight:700;color:{vc};">{value}</div>'
            f'{sub_html}</div>')

def badge(text, color, bg):
    return (f'<span style="font-size:10px;font-weight:700;letter-spacing:0.8px;'
            f'padding:3px 8px;border-radius:4px;color:{color};background:{bg};">'
            f'{text}</span>')

def status_badge(status):
    mapping = {
        "ACTIVE":   (SUCCESS, SUCCESS_RGBA),
        "DRAFT":    (TXT_MUT, SURF_HI),
        "EXPIRED":  (DANGER,  DANGER_RGBA),
        "FUNDED":   (ACCENT,  ACC_GLO),
        "PENDING":  (WARN,    WARN_RGBA),
    }
    color, bg = mapping.get(status, (TXT_MUT, SURF_HI))
    return badge(status, color, bg)

def input_field(label, value, mono=False, full=True):
    font   = "monospace" if mono else "inherit"
    width  = "100%" if full else "auto"
    return (f'<div style="margin-bottom:12px;">'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">{label}</div>'
            f'<div style="background:{SURF};border:1px solid {BORDER};border-radius:6px;'
            f'padding:9px 13px;font-size:13px;color:{TXT_SEC};font-family:{font};'
            f'width:{width};box-sizing:border-box;">{value}</div>'
            f'</div>')

def textarea_field(label, value, rows=3):
    return (f'<div style="margin-bottom:12px;">'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">{label}</div>'
            f'<div style="background:{SURF};border:1px solid {BORDER};border-radius:6px;'
            f'padding:9px 13px;font-size:13px;color:{TXT_SEC};line-height:1.5;'
            f'min-height:{rows*22}px;">{value}</div>'
            f'</div>')

def btn(label, color=ACCENT, text_color=TXT_PRI, small=False):
    pad = "6px 14px" if small else "9px 20px"
    fs  = "12px" if small else "13px"
    return (f'<div style="display:inline-block;padding:{pad};background:{color};'
            f'border-radius:6px;font-size:{fs};font-weight:700;color:{text_color};'
            f'cursor:pointer;letter-spacing:0.3px;">{label}</div>')

def btn_outline(label, small=False):
    pad = "5px 13px" if small else "8px 19px"
    fs  = "12px" if small else "13px"
    return (f'<div style="display:inline-block;padding:{pad};background:transparent;'
            f'border:1px solid {BORDER};border-radius:6px;font-size:{fs};'
            f'color:{TXT_SEC};cursor:pointer;">{label}</div>')

def sidebar(active):
    nav_items = [
        ("Dashboard",   "&#9632;"),
        ("Campaigns",   "&#9670;"),
        ("Judges",      "&#9650;"),
        ("Settings",    "&#9711;"),
    ]
    items_html = ""
    for name, icon in nav_items:
        is_active = (name == active)
        bg    = ACC_GLO if is_active else "transparent"
        color = TXT_PRI if is_active else TXT_MUT
        bdr   = f"border-left:2px solid {ACCENT};" if is_active else "border-left:2px solid transparent;"
        items_html += (
            f'<div style="display:flex;align-items:center;gap:10px;padding:9px 16px;'
            f'background:{bg};{bdr}cursor:pointer;margin-bottom:2px;">'
            f'<span style="font-size:10px;color:{ACCENT};">{icon}</span>'
            f'<span style="font-size:13px;color:{color};">{name}</span>'
            f'</div>'
        )
    return f"""
    <div style="width:{SBW}px;flex-shrink:0;background:{SURF};border-right:1px solid {BORDER};
                display:flex;flex-direction:column;height:100%;">
      <div style="padding:16px 16px 12px;border-bottom:1px solid {BORDER};">
        <div style="font-size:11px;font-weight:700;color:{ACCENT};letter-spacing:1px;margin-bottom:2px;">NGO ADMIN</div>
        <div style="font-size:13px;font-weight:700;color:{TXT_PRI};">Alzheimer's Research Alliance</div>
      </div>
      <div style="padding:10px 0;flex:1;">
        {items_html}
      </div>
      <div style="padding:12px 16px;border-top:1px solid {BORDER};">
        <div style="font-size:12px;color:{TXT_MUT};">ara-admin@ara.org</div>
        <div style="font-size:11px;color:{INACT};margin-top:2px;cursor:pointer;">Sign out</div>
      </div>
    </div>"""

def page_shell(active, content_html, fh):
    return f"""
<div style="width:{FW}px;height:{fh}px;overflow:hidden;background:{BG};
            font-family:Inter,system-ui,sans-serif;color:{TXT_PRI};
            display:flex;flex-direction:row;">
  {sidebar(active)}
  <div style="flex:1;overflow:hidden;display:flex;flex-direction:column;">
    {content_html}
  </div>
</div>"""

