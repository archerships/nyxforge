#!/usr/bin/env python3
"""
NyxForge Judge Registry mockup generator.
Generates docs/storyboards/out/judge-registry-mockup.html

5 frames:
  1. Browse         -- searchable judge list with reputation/fees
  2. Judge Profile  -- history, verdict record, fee schedule, specialization
  3. Invite Judge   -- add a judge to a bounty's judge panel
  4. Rate Judge     -- post-verdict rating submission
  5. Become Judge   -- register as a judge on-chain
"""
import os

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
OUTDIR     = os.path.join(os.environ.get("NYXFORGE_ROOT", os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))), "docs/storyboards/out")
OUTFILE    = os.path.join(OUTDIR, "judge-registry-mockup.html")

BG=("#0d0f1a");SURF=("#131524");SURF_HI=("#1a1d2e")
ACCENT=("#5e6ad2");ACC_GLO=("#2d3068");TXT_PRI=("#e8eaf0")
TXT_SEC=("#b8c0d8");TXT_MUT=("#8b95b0");SUCCESS=("#4ade80")
DANGER=("#f87171");WARN=("#fbbf24");BORDER=("#2a2d3e");INACT=("#3a3d5c")
SUCCESS_RGBA="rgba(74,222,128,0.10)";WARN_RGBA="rgba(251,191,36,0.10)"
ACCENT_RGBA="rgba(94,106,210,0.12)"
FW=980

def sl(t): return f'<div style="font-size:11px;font-weight:700;letter-spacing:1.2px;color:{ACCENT};margin-bottom:8px;">{t}</div>'
def div(mb=12): return f'<div style="height:1px;background:{BORDER};margin:0 0 {mb}px;"></div>'
def pill(t,c,bg): return f'<span style="font-size:10px;font-weight:700;letter-spacing:0.8px;padding:3px 9px;border-radius:4px;color:{c};background:{bg};">{t}</span>'
def btn(l,color=SUCCESS,text_color=BG,small=False,full=False):
    p="7px 16px" if small else "13px 28px";fs="12px" if small else "14px"
    w="width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return f'<div style="{w}padding:{p};background:{color};border-radius:7px;font-size:{fs};font-weight:700;color:{text_color};cursor:pointer;">{l}</div>'
def btn_o(l,small=False,color=None,full=False):
    p="6px 14px" if small else "12px 27px";fs="12px" if small else "14px"
    col=color or TXT_SEC;brd=color or BORDER
    w="width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return f'<div style="{w}padding:{p};background:transparent;border:1px solid {brd};border-radius:7px;font-size:{fs};color:{col};cursor:pointer;">{l}</div>'
def inp(label,val,mono=False,note=None):
    f="monospace" if mono else "inherit"
    n=f'<div style="font-size:11px;color:{TXT_MUT};margin-top:4px;">{note}</div>' if note else ""
    return (f'<div style="margin-bottom:12px;"><div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">{label}</div>'
            f'<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:6px;padding:9px 13px;font-size:13px;color:{TXT_MUT};font-family:{f};">{val}</div>{n}</div>')
def _rating_group(label, opts):
    items = "".join(
        f'<div style="padding:5px 12px;background:{ACC_GLO if j==0 else SURF_HI};'
        f'border:1px solid {ACCENT if j==0 else BORDER};border-radius:5px;'
        f'font-size:12px;color:{ACCENT if j==0 else TXT_MUT};cursor:pointer;">{o}</div>'
        for j, o in enumerate(opts)
    )
    return (f'<div><div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">{label}</div>'
            f'<div style="display:flex;gap:6px;">{items}</div></div>')

def star_rating(n,max=5):
    return "".join(f'<span style="color:{"' + WARN + '" if i<n else INACT};font-size:14px;">&#9733;</span>' for i in range(max))
def hdr():
    return f"""<div style="background:{SURF};border-bottom:1px solid {BORDER};padding:13px 24px;
              display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:14px;">
      <div style="width:28px;height:28px;border-radius:6px;background:{ACC_GLO};display:flex;align-items:center;justify-content:center;font-size:16px;">&#x2696;</div>
      <div><div style="font-size:15px;font-weight:700;color:{TXT_PRI};">Judge Registry</div>
           <div style="font-size:11px;color:{TXT_MUT};">Browse and evaluate judges</div></div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:6px;padding:7px 14px;font-size:13px;color:{TXT_MUT};">&#x1F50D; Search judges...</div>
      {btn("Become a Judge",color=ACCENT,text_color=TXT_PRI,small=True)}
    </div></div>"""
def frame(title,sub,body):
    return f"""<div style="background:{BG};min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  {hdr()}
  <div style="max-width:{FW}px;margin:0 auto;padding:28px 32px;">
    <div style="margin-bottom:22px;">
      <div style="font-size:11px;font-weight:700;letter-spacing:1.2px;color:{ACCENT};margin-bottom:4px;text-transform:uppercase;">{title}</div>
      <div style="font-size:22px;font-weight:700;color:{TXT_PRI};">{sub}</div>
    </div>
    {body}
  </div></div>"""

def judge_row(fp,handle,role,verdicts,rating,fee,resp,avail):
    role_c={"qualitative":SUCCESS,"quantitative":ACCENT,"both":WARN}.get(role,TXT_MUT)
    avail_c=SUCCESS if avail=="Available" else WARN
    return f"""<div style="display:grid;grid-template-columns:140px 1fr 110px 80px 80px 90px 90px 80px;
              gap:12px;align-items:center;padding:12px 16px;background:{SURF};border:1px solid {BORDER};
              border-radius:8px;margin-bottom:8px;cursor:pointer;">
  <div style="font-family:monospace;font-size:11px;color:{ACCENT};">{fp}</div>
  <div><div style="font-size:13px;font-weight:600;color:{TXT_PRI};">{handle}</div>
       <div style="font-size:10px;color:{role_c};margin-top:2px;">{role.upper()}</div></div>
  <div><div>{star_rating(rating)}</div><div style="font-size:11px;color:{TXT_MUT};">{verdicts} verdicts</div></div>
  <div style="font-size:13px;color:{TXT_PRI};">{rating}/5</div>
  <div style="font-size:13px;color:{WARN};font-weight:600;">{fee} XMR</div>
  <div style="font-size:11px;color:{TXT_MUT};">{resp}</div>
  <div style="font-size:11px;color:{avail_c};">{avail}</div>
  <div>{btn_o("View",small=True)}</div>
</div>"""

