    brd  = ACCENT       if accent else BORDER
    vcol = ACCENT       if accent else TXT_PRI
    scol = TXT_SEC      if accent else TXT_MUT
    sub_html = (f'<div style="font-size:11px;color:{scol};margin-top:3px;">{sub}</div>'
                if sub else "")
    return (f'<div style="background:{bg};border:1px solid {brd};border-radius:8px;'
            f'padding:13px 16px;">'
            f'<div style="font-size:11px;color:{TXT_MUT};letter-spacing:0.8px;">{label}</div>'
            f'<div style="font-size:22px;font-weight:700;color:{vcol};margin-top:3px;">{value}</div>'
            f'{sub_html}</div>')

