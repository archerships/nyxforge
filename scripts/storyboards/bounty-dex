    return (f'<div style="display:grid;'
            f'grid-template-columns:90px 2fr 90px 100px 90px 70px 110px 100px;'
            f'gap:8px;align-items:center;padding:11px 16px;'
            f'border-bottom:1px solid {BORDER};font-size:13px;cursor:pointer;"'
            f' onmouseover="this.style.background=\'{SURF_HI}\'"'
            f' onmouseout="this.style.background=\'transparent\'">'
            f'<div style="font-family:monospace;font-size:10px;color:{TXT_MUT};">{bounty_id}</div>'
            f'<div style="color:{TXT_PRI};">{name}</div>'
            f'<div style="font-family:monospace;color:{TXT_SEC};text-align:right;">{collateral}</div>'
            f'<div style="font-size:11px;color:{TXT_MUT};font-family:monospace;">{deadline}</div>'
            f'<div style="font-family:monospace;font-weight:700;color:{TXT_PRI};text-align:right;">{ask}</div>'
            f'<div style="font-size:11px;font-weight:700;color:{disc_col};text-align:right;">{discount}</div>'
            f'<div>{status_pill(judge_status, ACCENT, ACCENT_RGBA)}</div>'
            f'<div>{btn("Buy", color=ACCENT, text_color=TXT_PRI, small=True)}</div>'
            f'</div>')

def step_node(n, label, state):
    if state == "done":
        bg, brd, ncol, lcol = ACC_GLO, ACCENT, ACCENT, TXT_SEC
        sym = "&#10003;"
    elif state == "active":
        bg, brd, ncol, lcol = ACCENT, ACCENT, BG, TXT_PRI
        sym = str(n)
    else:
        bg, brd, ncol, lcol = SURF_HI, INACT, TXT_MUT, TXT_MUT
        sym = str(n)
    return (f'<div style="display:flex;flex-direction:column;align-items:center;gap:6px;">'
            f'<div style="width:32px;height:32px;border-radius:16px;background:{bg};'
            f'border:2px solid {brd};display:flex;align-items:center;justify-content:center;'
            f'font-size:13px;font-weight:700;color:{ncol};">{sym}</div>'
            f'<div style="font-size:11px;color:{lcol};white-space:nowrap;">{label}</div>'
            f'</div>')

