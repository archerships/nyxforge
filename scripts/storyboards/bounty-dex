def filter_bar(active="All"):
    filters = ["All", "Active", "Window Open", "Near Deadline"]
    pills = ""
    for f in filters:
        if f == active:
            pills += (f'<div style="padding:5px 14px;border-radius:5px;background:{ACCENT};'
                      f'font-size:12px;font-weight:700;color:{TXT_PRI};cursor:pointer;">{f}</div>')
        else:
            pills += (f'<div style="padding:5px 14px;border-radius:5px;background:transparent;'
                      f'font-size:12px;color:{TXT_MUT};cursor:pointer;">{f}</div>')
    return (f'<div style="display:flex;align-items:center;gap:4px;padding:10px 24px;'
            f'border-bottom:1px solid {BORDER};background:{SURF};">'
            f'<div style="display:flex;gap:2px;background:{SURF_HI};border:1px solid {BORDER};'
            f'border-radius:7px;padding:3px;">{pills}</div>'
            f'<div style="flex:1;"></div>'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-right:8px;">Sort by:</div>'
            f'<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:5px;'
            f'padding:5px 12px;font-size:12px;color:{TXT_SEC};display:flex;align-items:center;gap:6px;">'
            f'Deadline &nbsp;&#9660;</div>'
            f'</div>')

def stat_card(label, value, sub=None, accent=False):
