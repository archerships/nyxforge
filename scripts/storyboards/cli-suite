                   border-radius:7px;color:{TXT_SEC};font-size:13px;cursor:pointer;">
      &larr; Prev
    </button>
    <button id="next-btn" onclick="navigate(1)"
            style="padding:8px 16px;background:{SURF_HI};border:1px solid {BORDER};
                   border-radius:7px;color:{TXT_SEC};font-size:13px;cursor:pointer;">
      Next &rarr;
    </button>
  </div>

  <!-- frame content -->
  <div id="frames">{frame_bodies}</div>

  <script>
    let cur = 0;
    const total = {len(FRAMES)};
    const frames = document.querySelectorAll('[data-frame]');
    const tabs   = document.querySelectorAll('[data-idx]');
    const ACCENT = '{ACCENT}', MUT = '{TXT_MUT}';

    function show(idx) {{
      frames[cur].style.display = 'none';
      tabs[cur].style.color = MUT;
      tabs[cur].style.borderBottomColor = 'transparent';
      tabs[cur].setAttribute('aria-selected', 'false');
      cur = idx;
      frames[cur].style.display = 'block';
      tabs[cur].style.color = ACCENT;
      tabs[cur].style.borderBottomColor = ACCENT;
      tabs[cur].setAttribute('aria-selected', 'true');
      window.scrollTo(0, 0);
    }}

    function navigate(dir) {{
      show((cur + dir + total) % total);
    }}

    tabs.forEach(t => t.addEventListener('click', () => show(+t.dataset.idx)));

    document.addEventListener('keydown', e => {{
      if (e.key === 'ArrowRight') navigate(1);
      if (e.key === 'ArrowLeft')  navigate(-1);
    }});
  </script>
</body>
</html>"""


