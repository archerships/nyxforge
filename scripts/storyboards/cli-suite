#!/usr/bin/env python3
"""
NyxForge CLI Suite mockup generator.
Generates docs/storyboards/out/cli-suite-mockup.html

Shows realistic terminal sessions for the `nyx` unified CLI tool,
mirroring the functionality of all 8 NyxForge UI mockups.

8 frames:
  1. nyx bounty   -- create, list, inspect .bounty files
  2. nyx auction  -- list auctions, place bid, settlement
  3. nyx judge    -- list claims, review evidence, submit verdict
  4. nyx dex      -- list offers, take offer, track trade
  5. nyx wallet   -- balance, send, receive, mine
  6. nyx swap     -- fiat-to-XMR (Haveno/Retoswap style)
  7. nyx ngo      -- donation intake, auto-convert, treasury
  8. nyx tax      -- generate 990/8949, export receipts
"""
import os

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
OUTDIR     = os.path.join(os.environ.get("NYXFORGE_ROOT", os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))), "docs/storyboards/out")
OUTFILE    = os.path.join(OUTDIR, "cli-suite-mockup.html")

# ---------------------------------------------------------------------------
# Palette
# ---------------------------------------------------------------------------
BG       = "#0d0f1a"
SURF     = "#131524"
SURF_HI  = "#1a1d2e"
ACCENT   = "#5e6ad2"
ACC_GLO  = "#2d3068"
TXT_PRI  = "#e8eaf0"
TXT_SEC  = "#b8c0d8"
TXT_MUT  = "#8b95b0"
SUCCESS  = "#4ade80"
DANGER   = "#f87171"
WARN     = "#fbbf24"
BORDER   = "#2a2d3e"
INACT    = "#3a3d5c"

# Terminal-specific colors
T_BG     = "#080a10"   # terminal window bg
T_SURF   = "#0f1118"   # terminal inner
T_GREEN  = "#4ade80"
T_CYAN   = "#67e8f9"
T_PURPLE = "#c084fc"
T_YELLOW = "#fbbf24"
T_RED    = "#f87171"
T_BLUE   = "#818cf8"
T_GRAY   = "#6b7280"
T_WHITE  = "#e8eaf0"
T_DIM    = "#4b5563"

FW = 980

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def section_label(text):
    return (f'<div style="font-size:11px;font-weight:700;letter-spacing:1.2px;'
            f'color:{ACCENT};margin-bottom:8px;">{text}</div>')

def divider(mb=12):
    return f'<div style="height:1px;background:{BORDER};margin:0 0 {mb}px;"></div>'

def status_pill(text, color, bg):
    return (f'<span style="font-size:10px;font-weight:700;letter-spacing:0.8px;'
            f'padding:3px 9px;border-radius:4px;color:{color};background:{bg};">'
            f'{text}</span>')

def btn(label, color=SUCCESS, text_color=BG, small=False, full=False):
    pad = "7px 16px" if small else "13px 28px"
    fs  = "12px"    if small else "14px"
    wid = "width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return (f'<div style="{wid}padding:{pad};background:{color};'
            f'border-radius:7px;font-size:{fs};font-weight:700;color:{text_color};'
            f'cursor:pointer;letter-spacing:0.3px;">{label}</div>')

def btn_outline(label, small=False, color=None, full=False):
    pad = "6px 14px"  if small else "12px 27px"
    fs  = "12px"      if small else "14px"
    col = color or TXT_SEC
    brd = color or BORDER
    wid = "width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return (f'<div style="{wid}padding:{pad};background:transparent;'
            f'border:1px solid {brd};border-radius:7px;font-size:{fs};'
            f'color:{col};cursor:pointer;">{label}</div>')

# ---------------------------------------------------------------------------
# Terminal rendering helpers
# ---------------------------------------------------------------------------

def c(text, color):
    """Wrap text in a colored span."""
    return f'<span style="color:{color};">{text}</span>'

def prompt(path="~", user="archer"):
    """Render a shell prompt line."""
    return (f'<span style="color:{T_PURPLE};">{user}</span>'
            f'<span style="color:{T_DIM};">@</span>'
            f'<span style="color:{T_BLUE};">nyxnode</span>'
            f'<span style="color:{T_DIM};">:</span>'
            f'<span style="color:{T_CYAN};">{path}</span>'
            f'<span style="color:{T_GREEN};"> $ </span>')

def cmd(text):
    """Render a typed command."""
    return f'<span style="color:{T_WHITE};">{text}</span>'

def comment(text):
    return f'<span style="color:{T_DIM};"># {text}</span>'

def kv(key, val, key_color=T_CYAN, val_color=T_WHITE, pad=22):
    """Key-value output line, left-padded key."""
    return (f'  <span style="color:{key_color};">{key.ljust(pad)}</span>'
            f'<span style="color:{val_color};">{val}</span>')

def header_line(text):
    return f'<span style="color:{T_PURPLE};font-weight:700;">{text}</span>'

def success_line(text):
    return f'<span style="color:{T_GREEN};">{text}</span>'

def warn_line(text):
    return f'<span style="color:{T_YELLOW};">{text}</span>'

def err_line(text):
    return f'<span style="color:{T_RED};">{text}</span>'

def dim_line(text):
    return f'<span style="color:{T_DIM};">{text}</span>'

def sep_line(char="-", width=72):
    return f'<span style="color:{T_DIM};">{char * width}</span>'

def blank():
    return ""

def cursor():
    return f'<span style="background:{T_GREEN};color:{T_BG};">&nbsp;</span>'

# ---------------------------------------------------------------------------
# Terminal window wrapper
# ---------------------------------------------------------------------------

def terminal_window(title, lines, h=None):
    """Render a macOS-style terminal window."""
    height_style = f"height:{h}px;overflow:hidden;" if h else "min-height:200px;"
    rows = "".join(f'<div style="line-height:1.7;min-height:1em;">{ln}</div>' for ln in lines)
    return f"""
<div style="border-radius:10px;overflow:hidden;border:1px solid {BORDER};
            box-shadow:0 8px 32px rgba(0,0,0,0.6);">
  <!-- title bar -->
  <div style="background:#1c1e2a;padding:10px 14px;display:flex;align-items:center;gap:10px;
              border-bottom:1px solid {BORDER};">
    <div style="width:11px;height:11px;border-radius:50%;background:#ff5f56;"></div>
    <div style="width:11px;height:11px;border-radius:50%;background:#ffbd2e;"></div>
    <div style="width:11px;height:11px;border-radius:50%;background:#27c93f;"></div>
    <div style="flex:1;text-align:center;font-size:11px;color:{T_DIM};letter-spacing:0.5px;">
      {title}
    </div>
  </div>
  <!-- terminal body -->
  <div style="background:{T_BG};padding:16px 18px;font-family:'JetBrains Mono',
              'Fira Code','Cascadia Code',monospace;font-size:12.5px;{height_style}
              overflow-y:auto;">
    {rows}
  </div>
</div>"""

# ---------------------------------------------------------------------------
# Side panel: command reference
# ---------------------------------------------------------------------------

def cmd_ref(title, entries):
    """entries = list of (cmd_str, desc) tuples."""
    rows = "".join(
        f'<div style="display:flex;gap:10px;margin-bottom:6px;">'
        f'<div style="flex:0 0 auto;font-family:monospace;font-size:11px;'
        f'color:{ACCENT};white-space:nowrap;">{e[0]}</div>'
        f'<div style="font-size:11px;color:{TXT_MUT};">{e[1]}</div>'
        f'</div>'
        for e in entries
    )
    return f"""
<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:8px;padding:14px 16px;">
  <div style="font-size:11px;font-weight:700;letter-spacing:1px;color:{TXT_MUT};
              margin-bottom:10px;text-transform:uppercase;">{title}</div>
  {rows}
</div>"""

# ---------------------------------------------------------------------------
# Frame builder
# ---------------------------------------------------------------------------

def frame(title, subtitle, left_content, right_top=None, right_bot=None, note=None):
    right = ""
    if right_top or right_bot:
        top = right_top or ""
        bot = (f'<div style="margin-top:14px;">{right_bot}</div>') if right_bot else ""
        right = f"""
<div style="flex:0 0 300px;display:flex;flex-direction:column;gap:14px;">
  {top}{bot}
</div>"""
    note_html = ""
    if note:
        note_html = (f'<div style="margin-top:14px;padding:10px 14px;background:{SURF_HI};'
                     f'border-left:3px solid {ACCENT};border-radius:0 6px 6px 0;'
                     f'font-size:12px;color:{TXT_SEC};">{note}</div>')
    return f"""
<div style="background:{BG};min-height:100vh;padding:28px 32px;
            font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  <div style="max-width:{FW}px;margin:0 auto;">
    <!-- page header -->
    <div style="margin-bottom:22px;">
      <div style="font-size:11px;font-weight:700;letter-spacing:1.2px;
                  color:{ACCENT};margin-bottom:4px;text-transform:uppercase;">{title}</div>
      <div style="font-size:22px;font-weight:700;color:{TXT_PRI};">{subtitle}</div>
    </div>
    <!-- body -->
    <div style="display:flex;gap:20px;align-items:flex-start;">
      <div style="flex:1;min-width:0;">{left_content}{note_html}</div>
      {right}
    </div>
  </div>
</div>"""

