def processor_card(name, symbol, brand_color, bg_color, connected,
                   fields, notes="", webhook_url=""):
    status_html = (status_pill("CONNECTED", SUCCESS, SUCCESS_RGBA) if connected
                   else status_pill("NOT CONNECTED", TXT_MUT, SURF_HI))
    wh_html = ""
    if webhook_url:
        wh_html = (f'<div style="margin-top:10px;">'
                   f'<div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">'
                   f'Webhook endpoint (paste into your dashboard)</div>'
                   f'<div style="background:{SURF_HI};border:1px solid {BORDER};'
                   f'border-radius:6px;padding:9px 13px;font-size:11px;'
                   f'font-family:monospace;color:{ACCENT};">{webhook_url}</div></div>')
    field_html = "".join(
        input_field(l, v, mono=mono, password=pw)
        for l, v, mono, pw in fields
    )
    note_html = (f'<div style="font-size:12px;color:{TXT_MUT};line-height:1.6;'
                 f'margin-top:8px;">{notes}</div>' if notes else "")
    return (f'<div style="background:{SURF};border:1px solid {BORDER};border-radius:10px;'
            f'padding:16px 18px;margin-bottom:14px;">'
            f'<div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">'
            f'<div style="width:42px;height:42px;border-radius:10px;background:{bg_color};'
            f'display:flex;align-items:center;justify-content:center;'
            f'font-size:11px;font-weight:700;color:{brand_color};flex-shrink:0;">{symbol}</div>'
            f'<div style="flex:1;">'
            f'<div style="font-size:15px;font-weight:700;color:{TXT_PRI};">{name}</div>'
            f'<div style="font-size:11px;color:{TXT_MUT};margin-top:2px;">'
            f'{"Active" if connected else "Click to connect"}</div></div>'
            f'{status_html}</div>'
            f'<div style="height:1px;background:{BORDER};margin-bottom:14px;"></div>'
            + field_html + wh_html + note_html
            + f'<div style="display:flex;gap:8px;margin-top:12px;">'
            + (btn("Save Changes", color=ACCENT, text_color=TXT_PRI, small=True)
               if connected else
               btn("Connect", color=SUCCESS, text_color=BG, small=True))
            + f'&nbsp;&nbsp;'
            + (btn_outline("Test Webhook", small=True) if connected else "")
            + f'&nbsp;&nbsp;'
            + (btn_outline("Disconnect", small=True, color=DANGER) if connected else "")
            + f'</div></div>')

