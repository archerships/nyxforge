CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

def render_frame_png(frame_idx, frame, children, out_path):
    """Render one frame as a standalone PNG via headless Chrome."""
    fx, fy = frame["x"], frame["y"]
    fw, fh = int(frame["width"]), int(frame["height"])
    bg = frame["fills"][0]["fill-color"] if frame.get("fills") else BG
    inner = ""
    for s in children:
        inner += shape_to_css(s, fx, fy)
    # Render 200px taller than content to avoid Chrome's bottom-clip quirk,
    # then PIL-crop back to the correct frame height.
    render_h = fh + 200
    html = f"""<!DOCTYPE html>
<html><head><meta charset="utf-8">
<style>*{{box-sizing:border-box;margin:0;padding:0;}}
body{{background:{bg};width:{fw}px;min-height:{fh}px;
     font-family:Inter,system-ui,sans-serif;}}</style>
</head><body>
<div style="position:relative;width:{fw}px;height:{fh}px;background:{bg};">{inner}</div>
</body></html>"""
    tmp = f"/tmp/wiz-frame-{frame_idx+1}.html"
    with open(tmp, "w") as f:
        f.write(html)
    raw = f"/tmp/wiz-raw-{frame_idx+1}.png"
    subprocess.run([
        CHROME, "--headless", "--disable-gpu",
        "--force-device-scale-factor=1",
        f"--screenshot={raw}",
        f"--window-size={fw},{render_h}",
        f"file://{tmp}",
    ], check=True, capture_output=True)
    # Crop to exact frame height
    from PIL import Image
    img = Image.open(raw)
    img.crop((0, 0, fw, min(fh, img.height))).save(out_path)

for i, (frame, children) in enumerate(preview_data):
    out = f"/tmp/wiz-step-{i+1}.png"
    render_frame_png(i, frame, children, out)
    print(f"  Frame {i+1}: {out}")

