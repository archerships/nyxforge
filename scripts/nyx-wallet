# ---------------------------------------------------------------------------
# Frame 5 -- Mining
# ---------------------------------------------------------------------------

import math as _math

def emission_curve_svg(w=560, h=160):
    """
    NYX emission curve: 10 trillion tokens over 100 years.
    Uses an exponential decay schedule: emission_rate(t) = A * e^(-k*t)
    Integrated so total area = 10T. We show cumulative supply vs time.
    k chosen so ~65% emitted by year 20, ~90% by year 50.
    """
    pad_l, pad_r, pad_t, pad_b = 52, 16, 14, 36
    cw = w - pad_l - pad_r
    ch = h - pad_t - pad_b

    TOTAL   = 10_000_000_000_000   # 10 trillion
    YEARS   = 100
    k       = 0.055                # decay constant
    # normalise so integral from 0..100 = TOTAL
    # integral of e^(-kt) from 0..T = (1 - e^(-kT)) / k
    norm    = (1 - _math.exp(-k * YEARS)) / k

    def cumulative(t):
        return TOTAL * (1 - _math.exp(-k * t)) / norm

    def x_for_t(t):
        return pad_l + cw * (t / YEARS)

    def y_for_supply(s):
        return pad_t + ch * (1 - s / TOTAL)

    # Cumulative supply curve
    pts = []
    for i in range(101):
        t = i
        pts.append(f"{x_for_t(t):.1f},{y_for_supply(cumulative(t)):.1f}")
    curve = " ".join(pts)

    # Fill area under curve
    fill_pts = [(pad_l, pad_t + ch)]
    for i in range(101):
        t = i
        fill_pts.append((x_for_t(t), y_for_supply(cumulative(t))))
    fill_pts.append((pad_l + cw, pad_t + ch))
    fill_poly = " ".join(f"{x:.1f},{y:.1f}" for x, y in fill_pts)

    # Current year marker (year 0 = launch, show at year 1)
    cur_t  = 1
    cur_x  = x_for_t(cur_t)
    cur_y  = y_for_supply(cumulative(cur_t))
    cur_s  = cumulative(cur_t) / 1e9  # billions

    # Y-axis labels (trillions)
    y_labels = ""
    for s_T in [0, 2.5, 5, 7.5, 10]:
        yy = y_for_supply(s_T * 1e12)
        y_labels += (f'<text x="{pad_l - 6}" y="{yy + 4}" '
                     f'text-anchor="end" font-size="10" fill="{TXT_MUT}">'
                     f'{int(s_T)}T</text>')

    # X-axis labels
    x_labels = ""
    for label, t in [("0", 0), ("25y", 25), ("50y", 50), ("75y", 75), ("100y", 100)]:
        xx = x_for_t(t)
        x_labels += (f'<text x="{xx}" y="{pad_t + ch + 18}" '
                     f'text-anchor="middle" font-size="10" fill="{TXT_MUT}">{label}</text>')

    # Grid lines
    grid = ""
    for s_T in [2.5, 5, 7.5]:
        yy = y_for_supply(s_T * 1e12)
        grid += (f'<line x1="{pad_l}" y1="{yy}" x2="{pad_l + cw}" y2="{yy}" '
                 f'stroke="{BORDER}" stroke-width="1"/>')
    for t in [25, 50, 75]:
        xx = x_for_t(t)
        grid += (f'<line x1="{xx}" y1="{pad_t}" x2="{xx}" y2="{pad_t + ch}" '
                 f'stroke="{BORDER}" stroke-width="1"/>')

    # Current position marker
    grid += (f'<line x1="{cur_x}" y1="{pad_t}" x2="{cur_x}" y2="{pad_t + ch}" '
             f'stroke="{NYX_COLOR}" stroke-width="1" stroke-dasharray="3,3"/>')
    cur_label = (f'<rect x="{cur_x + 6}" y="{cur_y - 14}" width="72" height="20" '
                 f'rx="4" fill="{ACC_GLO}" stroke="{NYX_COLOR}" stroke-width="1"/>'
                 f'<text x="{cur_x + 42}" y="{cur_y + 2}" text-anchor="middle" '
                 f'font-size="10" font-weight="700" fill="{NYX_COLOR}">'
                 f'Year 1</text>')

    # Milestone dots
    milestone_dots = ""
    for t_m, label_m in [(20, "65%"), (50, "90%")]:
        xm = x_for_t(t_m)
        ym = y_for_supply(cumulative(t_m))
        milestone_dots += (f'<circle cx="{xm}" cy="{ym}" r="3.5" '
                           f'fill="{NYX_COLOR}" opacity="0.6"/>'
                           f'<text x="{xm}" y="{ym - 7}" text-anchor="middle" '
                           f'font-size="9" fill="{TXT_MUT}">{label_m}</text>')

    return f"""
<svg width="{w}" height="{h}" xmlns="http://www.w3.org/2000/svg" style="display:block;">
  {grid}
  <line x1="{pad_l}" y1="{pad_t}" x2="{pad_l}" y2="{pad_t+ch}"
        stroke="{BORDER}" stroke-width="1"/>
  <line x1="{pad_l}" y1="{pad_t+ch}" x2="{pad_l+cw}" y2="{pad_t+ch}"
        stroke="{BORDER}" stroke-width="1"/>
  <polygon points="{fill_poly}" fill="{NYX_COLOR}" opacity="0.08"/>
  <polyline points="{curve}" fill="none" stroke="{NYX_COLOR}" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round"/>
  {milestone_dots}
  <circle cx="{cur_x}" cy="{cur_y}" r="5" fill="{NYX_COLOR}"
          stroke="{BG}" stroke-width="2"/>
  {y_labels}
  {x_labels}
  {cur_label}
</svg>"""


