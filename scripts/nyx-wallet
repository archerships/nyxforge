#!/usr/bin/env python3
"""
NyxForge Crypto Wallet mockup generator.
Generates docs/storyboards/out/nyx-wallet-mockup.html

Pre-bounty wallet for holding XMR, TARI, and NYX before locking
collateral into .bounty files.

5 frames:
  1. Portfolio   -- total balance, asset list, recent activity
  2. Coin Detail -- single-asset view, sparkline, tx history
  3. Receive     -- address display, ASCII QR placeholder, copy
  4. Send        -- recipient, amount, fee tier, confirm
  5. Mining      -- XMR merge-miner + NYX/TARI, emission curve, pool controls
"""
import os, subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
OUTDIR     = os.path.join(SCRIPT_DIR, "../docs/storyboards/out")
OUTFILE    = os.path.join(OUTDIR, "nyx-wallet-mockup.html")

# ---------------------------------------------------------------------------
# Palette
# ---------------------------------------------------------------------------
BG           = "#0d0f1a"
SURF         = "#131524"
SURF_HI      = "#1a1d2e"
ACCENT       = "#5e6ad2"
ACC_GLO      = "#2d3068"
TXT_PRI      = "#e8eaf0"
TXT_SEC      = "#b8c0d8"
TXT_MUT      = "#8b95b0"
SUCCESS      = "#4ade80"
DANGER       = "#f87171"
WARN         = "#fbbf24"
BORDER       = "#2a2d3e"
INACT        = "#3a3d5c"
SUCCESS_RGBA = "rgba(74,222,128,0.10)"
WARN_RGBA    = "rgba(251,191,36,0.10)"
ACCENT_RGBA  = "rgba(94,106,210,0.12)"
DANGER_RGBA  = "rgba(248,113,113,0.10)"

FW = 900

# Coin brand accents
XMR_COLOR  = "#ff6600"
TARI_COLOR = "#9b59f5"
NYX_COLOR  = ACCENT

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def section_label(text):
    return (f'<div style="font-size:11px;font-weight:700;letter-spacing:1.2px;'
            f'color:{ACCENT};margin-bottom:8px;">{text}</div>')

def divider(mb=12):
    return f'<div style="height:1px;background:{BORDER};margin:0 0 {mb}px;"></div>'

def status_pill(text, color, bg):
    return (f'<span style="font-size:10px;font-weight:700;letter-spacing:0.8px;'
            f'padding:3px 9px;border-radius:4px;color:{color};background:{bg};">'
            f'{text}</span>')

def btn(label, color=SUCCESS, text_color=BG, small=False, full=False):
    pad = "7px 16px" if small else "13px 28px"
    fs  = "12px"    if small else "14px"
    wid = "width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return (f'<div style="{wid}padding:{pad};background:{color};'
            f'border-radius:7px;font-size:{fs};font-weight:700;color:{text_color};'
            f'cursor:pointer;letter-spacing:0.3px;">{label}</div>')

def btn_outline(label, small=False, color=None, full=False):
    pad  = "6px 14px"  if small else "12px 27px"
    fs   = "12px"      if small else "14px"
    col  = color or TXT_SEC
    bord = color or BORDER
    wid  = "width:100%;display:block;text-align:center;" if full else "display:inline-block;"
    return (f'<div style="{wid}padding:{pad};background:transparent;'
            f'border:1px solid {bord};border-radius:7px;font-size:{fs};'
            f'color:{col};cursor:pointer;">{label}</div>')

def input_field(label, value, mono=False, note=None):
    font = "monospace" if mono else "inherit"
    n = (f'<div style="font-size:11px;color:{TXT_MUT};margin-top:4px;">{note}</div>'
         if note else "")
    return (f'<div style="margin-bottom:12px;">'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-bottom:4px;">{label}</div>'
            f'<div style="background:{SURF_HI};border:1px solid {BORDER};border-radius:6px;'
            f'padding:9px 13px;font-size:13px;color:{TXT_MUT};font-family:{font};">{value}</div>'
            f'{n}</div>')

def wallet_header(subtitle="Crypto Wallet"):
    return f"""
  <div style="background:{SURF};border-bottom:1px solid {BORDER};padding:13px 24px;
              display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:14px;">
      <div style="width:28px;height:28px;border-radius:6px;background:{ACC_GLO};
                  display:flex;align-items:center;justify-content:center;
                  font-size:11px;font-weight:700;color:{ACCENT};">NYX</div>
      <div>
        <div style="font-size:15px;font-weight:700;color:{TXT_PRI};">NyxForge Wallet</div>
        <div style="font-size:11px;color:{TXT_MUT};">{subtitle}</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;">
      <div style="font-size:12px;font-family:monospace;color:{TXT_MUT};">4AB...f9c2</div>
      <div style="width:8px;height:8px;border-radius:50%;background:{SUCCESS};"></div>
    </div>
  </div>"""

def coin_badge(symbol, color):
    return (f'<div style="width:36px;height:36px;border-radius:50%;'
            f'background:{color}22;border:2px solid {color};'
            f'display:flex;align-items:center;justify-content:center;'
            f'font-size:10px;font-weight:700;color:{color};flex-shrink:0;">'
            f'{symbol}</div>')

def tx_row(direction, desc, amount, coin_color, date, status="confirmed"):
    arrow = "&uarr;" if direction == "out" else "&darr;"
    arrow_col = DANGER if direction == "out" else SUCCESS
    sign = "-" if direction == "out" else "+"
    sign_col = DANGER if direction == "out" else SUCCESS
    pill_col = TXT_MUT if status == "confirmed" else WARN
    pill_bg  = SURF_HI if status == "confirmed" else WARN_RGBA
    return (f'<div style="display:flex;align-items:center;gap:12px;padding:9px 0;'
            f'border-bottom:1px solid {BORDER};">'
            f'<div style="width:30px;height:30px;border-radius:50%;'
            f'background:{arrow_col}22;display:flex;align-items:center;'
            f'justify-content:center;font-size:16px;color:{arrow_col};flex-shrink:0;">'
            f'{arrow}</div>'
            f'<div style="flex:1;min-width:0;">'
            f'<div style="font-size:13px;color:{TXT_PRI};">{desc}</div>'
            f'<div style="font-size:11px;color:{TXT_MUT};margin-top:2px;">{date}</div>'
            f'</div>'
            f'<div style="text-align:right;">'
            f'<div style="font-size:13px;font-weight:700;color:{sign_col};">'
            f'{sign}{amount}</div>'
            f'<div style="margin-top:3px;">{status_pill(status.upper(), pill_col, pill_bg)}'
            f'</div></div></div>')

# ---------------------------------------------------------------------------
# Sparkline SVG (balance history)
# ---------------------------------------------------------------------------

def sparkline_svg(points, w=340, h=48, color=ACCENT):
    """points: list of 0..1 normalised values"""
    n = len(points)
    xs = [i / (n - 1) * w for i in range(n)]
    ys = [(1 - p) * (h - 8) + 4 for p in points]
    path = "M " + " L ".join(f"{x:.1f},{y:.1f}" for x, y in zip(xs, ys))
    fill_path = (f"M {xs[0]:.1f},{h} L " +
                 " L ".join(f"{x:.1f},{y:.1f}" for x, y in zip(xs, ys)) +
                 f" L {xs[-1]:.1f},{h} Z")
    return (f'<svg width="{w}" height="{h}" xmlns="http://www.w3.org/2000/svg"'
            f' style="display:block;">'
            f'<path d="{fill_path}" fill="{color}" opacity="0.10"/>'
            f'<path d="{path}" fill="none" stroke="{color}" stroke-width="2"'
            f' stroke-linecap="round" stroke-linejoin="round"/>'
            f'<circle cx="{xs[-1]:.1f}" cy="{ys[-1]:.1f}" r="4"'
            f' fill="{color}" stroke="{BG}" stroke-width="2"/>'
            f'</svg>')

