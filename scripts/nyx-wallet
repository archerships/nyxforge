        30-day balance</div>
    </div>
  </div>
  <div style="height:1px;background:{BORDER};margin:16px 0 14px;"></div>
  <div style="display:flex;gap:10px;">
    {btn("Receive", color=ACCENT, text_color=TXT_PRI, small=True)}
    {btn("Send", color=SURF_HI, text_color=TXT_SEC, small=True)}
  </div>
</div>"""

def asset_row(symbol, name, color, balance_coin, balance_usd, change_pct, change_pos, locked):
    change_col = SUCCESS if change_pos else DANGER
    change_sign = "+" if change_pos else "-"
    locked_note = ""
    if locked:
        locked_note = (f'<span style="font-size:10px;color:{WARN};margin-left:8px;">'
                       f'{locked} locked</span>')
    return (f'<div style="display:flex;align-items:center;gap:14px;padding:11px 0;'
            f'border-bottom:1px solid {BORDER};cursor:pointer;"'
            f' onmouseover="this.style.background=\'{SURF_HI}\'"'
            f' onmouseout="this.style.background=\'transparent\'">'
            + coin_badge(symbol, color)
            + f'<div style="flex:1;min-width:0;">'
            f'<div style="font-size:14px;font-weight:700;color:{TXT_PRI};">{name}'
            f'  <span style="font-size:12px;font-weight:400;color:{TXT_MUT};">{symbol}</span>'
            f'{locked_note}</div>'
            f'<div style="font-size:12px;color:{TXT_MUT};margin-top:2px;">'
            f'{balance_coin}</div>'
            f'</div>'
            f'<div style="text-align:right;">'
            f'<div style="font-size:14px;font-weight:700;color:{TXT_PRI};">{balance_usd}</div>'
            f'<div style="font-size:12px;color:{change_col};margin-top:2px;">'
            f'{change_sign}{change_pct}</div>'
            f'</div></div>')

ASSET_LIST = (
    asset_row("XMR", "Monero",  XMR_COLOR, "9.842 XMR",  "$2,951.20", "2.8%", True,  "0.90 XMR")
